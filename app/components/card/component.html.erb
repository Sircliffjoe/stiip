<div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden transition-colors duration-200">
  <% if @title %>
    <div class="px-6 py-4 border-b border-gray-200">
      <h3 class="text-lg font-semibold leading-6 text-gray-900"><%= @title %></h3>
      <% if @subtitle %><p class="mt-1 text-sm text-gray-600"><%= @subtitle %></p><% end %>
    </div>
  <% end %>
  <div class="<%= @padding ? 'p-6' : '' %>">
    <%= content %>
  </div>
</div>
