<div class="bg-white shadow-sm rounded-lg overflow-hidden border border-gray-200">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
      <tr>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Company</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Amount</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Qual. Date</th>
        <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Pay Date</th>
      </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
      <% @dividends.each do |div| %>
        <tr>
          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= div[:company] %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">₦<%= div[:amount] %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= div[:qual_date] %></td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600"><%= div[:pay_date] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
