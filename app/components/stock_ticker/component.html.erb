<div class="w-full bg-gray-100 text-gray-900 overflow-hidden flex whitespace-nowrap py-2 text-sm border-b border-gray-300">
  <div class="flex animate-ticker gap-8 px-4">
    <% @stocks.each do |stock| %>
      <div class="flex items-center gap-2">
        <span class="font-semibold"><%= stock[:ticker] %></span>
        <span>₦<%= stock[:price] %></span>
        <span class="<%= stock[:change] >= 0 ? 'text-green-600' : 'text-red-600' %>">
          <%= stock[:change] >= 0 ? '+' : '' %><%= stock[:change] %>%
        </span>
      </div>
    <% end %>
  </div>
</div>
