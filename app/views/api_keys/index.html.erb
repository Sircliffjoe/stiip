<% content_for(:title, "API Access — NoraCapital") %>

<div class="space-y-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">API Access</h1>
      <p class="mt-2 max-w-2xl text-gray-600">Manage Business/API keys for commercial data integrations.</p>
    </div>
    <%= link_to "View Pricing", pricing_path, class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
  </div>

  <%= render "shared/account_nav" if user_signed_in? && !devise_controller? %>

  <% if @plain_token.present? %>
    <div class="rounded-xl border border-gold-500/40 bg-gold-100 p-5">
      <p class="text-sm font-semibold text-navy-900">Copy this API key now. It will not be shown again.</p>
      <code class="mt-3 block overflow-x-auto rounded-lg bg-white p-3 text-sm text-navy-900"><%= @plain_token %></code>
    </div>
  <% end %>

  <% unless current_access_policy.can_manage_api_keys? %>
    <%= render "shared/locked_feature",
      title: "Business/API plan required",
      message: "API access is available on the Business/API plan for commercial products, dashboards, reports, and integrations.",
      cta_label: "Upgrade to Business/API",
      cta_path: pricing_path,
      secondary_label: nil %>
  <% else %>
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-gray-900">Create API Key</h2>
      <%= form_with model: @api_key, class: "mt-4 flex flex-col gap-3 sm:flex-row" do |f| %>
        <%= f.text_field :name, placeholder: "Production integration", class: "flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-navy-500 focus:ring-navy-500" %>
        <%= f.submit "Create Key", class: "rounded-lg bg-navy-700 px-5 py-2 text-sm font-bold text-white hover:bg-navy-800" %>
      <% end %>
      <% if @api_key.errors.any? %>
        <p class="mt-3 text-sm text-red-600"><%= @api_key.errors.full_messages.to_sentence %></p>
      <% end %>
    </div>
  <% end %>

  <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="border-b border-gray-200 px-6 py-4">
      <h2 class="font-bold text-gray-900">Your API Keys</h2>
    </div>
    <% if @api_keys.any? %>
      <div class="divide-y divide-gray-100">
        <% @api_keys.each do |api_key| %>
          <div class="flex flex-col gap-4 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-semibold text-gray-900"><%= api_key.name %></p>
              <p class="mt-1 text-xs text-gray-500">
                Prefix <span class="font-mono"><%= api_key.token_prefix %></span> ·
                <%= number_with_delimiter(api_key.monthly_requests_count) %>/<%= number_with_delimiter(api_key.monthly_quota) %> monthly requests
              </p>
              <% if api_key.revoked_at.present? %>
                <p class="mt-1 text-xs font-semibold text-red-600">Revoked <%= time_ago_in_words(api_key.revoked_at) %> ago</p>
              <% elsif api_key.last_used_at.present? %>
                <p class="mt-1 text-xs text-gray-500">Last used <%= time_ago_in_words(api_key.last_used_at) %> ago</p>
              <% end %>
            </div>
            <% if api_key.revoked_at.blank? %>
              <%= button_to "Revoke", api_key_path(api_key), method: :delete, class: "rounded-lg border border-red-200 px-4 py-2 text-sm font-semibold text-red-600 hover:bg-red-50", form: { data: { turbo_confirm: "Revoke this API key?" } } %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-8 text-center text-sm text-gray-500">No API keys yet.</div>
    <% end %>
  </div>
</div>
