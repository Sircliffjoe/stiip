<div class="space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Notifications</h1>
      <p class="mt-1 text-gray-600"><%= pluralize(current_user.notifications.unread.count, "unread notification") %></p>
    </div>
    <% if current_user.notifications.unread.exists? %>
      <%= button_to "Mark all read", mark_all_read_notifications_path, method: :patch, class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
    <% end %>
  </div>

  <div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
    <% if @notifications.any? %>
      <div class="divide-y divide-gray-100">
        <% @notifications.each do |notification| %>
          <div class="flex flex-col gap-4 px-5 py-4 sm:flex-row sm:items-start sm:justify-between <%= notification.read_at? ? "" : "bg-purple-50/60" %>">
            <div>
              <div class="flex items-center gap-2">
                <h2 class="font-semibold text-gray-900"><%= notification.title %></h2>
                <% unless notification.read_at? %>
                  <span class="rounded-full bg-purple-100 px-2 py-0.5 text-xs font-medium text-purple-700">New</span>
                <% end %>
              </div>
              <p class="mt-1 text-sm text-gray-600"><%= notification.body %></p>
              <p class="mt-2 text-xs text-gray-500"><%= time_ago_in_words(notification.created_at) %> ago</p>
            </div>
            <% unless notification.read_at? %>
              <%= button_to "Mark read", notification_path(notification), method: :patch, class: "rounded-lg border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-white" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-10 text-center text-gray-500">No notifications yet.</div>
    <% end %>
  </div>
</div>
