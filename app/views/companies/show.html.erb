<div class="space-y-6">
  <div class="flex items-center gap-4">
    <a href="/companies" class="text-gray-400 hover:text-white transition flex items-center gap-1 text-sm font-medium">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Back
    </a>
  </div>

  <div class="bg-gray-900 border border-gray-800 rounded-2xl p-8 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl"></div>
    
    <div class="flex flex-col md:flex-row justify-between gap-6 relative z-10">
      <div class="flex items-center gap-6">
        <div class="w-20 h-20 rounded-2xl bg-gray-800 border border-gray-700 shadow-inner flex items-center justify-center font-bold text-emerald-400 text-2xl">
          <%= @company.ticker_symbol[0..1] %>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-white"><%= @company.name %></h1>
          <div class="flex items-center gap-3 mt-2 text-sm text-gray-400">
            <span class="px-2.5 py-1 bg-gray-800 rounded-md font-medium text-gray-300 border border-gray-700"><%= @company.ticker_symbol %></span>
            <span>•</span>
            <span><%= @company.sector&.name || 'Unknown Sector' %></span>
          </div>
        </div>
      </div>

      <div class="flex flex-col md:items-end justify-center">
        <p class="text-4xl font-bold text-white">₦<%= @company.latest_price || '0.00' %></p>
        <p class="text-sm text-emerald-400 font-semibold mt-1">▲ +2.4% Today</p>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-gray-800 grid grid-cols-2 md:grid-cols-4 gap-6 relative z-10">
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Market Cap</p>
        <p class="text-xl font-medium text-white mt-1.5">₦<%= @company.market_cap || 'N/A' %>B</p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">PE Ratio</p>
        <p class="text-xl font-medium text-white mt-1.5"><%= @company.pe_ratio || 'N/A' %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Div Yield</p>
        <p class="text-xl font-medium text-emerald-400 mt-1.5"><%= @company.dividend_yield || '0.0' %>%</p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">52 Wk High</p>
        <p class="text-xl font-medium text-white mt-1.5">₦<%= @company.high_52_week || 'N/A' %></p>
      </div>
    </div>
  </div>

  <!-- AI Explanation Card -->
  <div class="bg-gradient-to-br from-blue-900/40 to-gray-900 border border-blue-500/20 rounded-2xl p-6 flex gap-4 items-start relative overflow-hidden group">
    <div class="absolute inset-0 bg-blue-500/5 group-hover:bg-blue-500/10 transition-colors"></div>
    <div class="w-10 h-10 rounded-xl bg-blue-500/20 border border-blue-500/30 flex items-center justify-center text-blue-400 shrink-0 relative z-10">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    </div>
    <div class="relative z-10">
      <h3 class="font-bold text-blue-300">What this means for you</h3>
      <p class="text-sm text-gray-300 mt-1.5 leading-relaxed"><%= @company.pe_ratio_explanation %></p>
    </div>
  </div>
</div>
