<div class="space-y-6">
  <div class="flex items-center gap-4">
    <a href="/companies" class="text-gray-600 hover:text-gray-900 transition flex items-center gap-1 text-sm font-medium">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
      Back
    </a>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl p-8 relative overflow-hidden shadow-sm">
    <div class="absolute top-0 right-0 w-64 h-64 bg-navy-200/20 rounded-full blur-3xl"></div>
    
    <div class="flex flex-col md:flex-row justify-between gap-6 relative z-10">
      <div class="flex items-center gap-6">
        <div class="w-20 h-20 rounded-2xl bg-navy-700 border border-navy-200 shadow-inner flex items-center justify-center font-bold text-white text-2xl">
          <%= @company.ticker_symbol[0..1] %>
        </div>
        <div>
          <h1 class="text-3xl font-bold text-gray-900"><%= @company.name %></h1>
          <div class="flex items-center gap-3 mt-2 text-sm text-gray-600">
            <span class="px-2.5 py-1 bg-navy-100 rounded-md font-medium text-navy-700 border border-navy-200"><%= @company.ticker_symbol %></span>
            <span>•</span>
            <span><%= @company.sector&.name || 'Unknown Sector' %></span>
          </div>
        </div>
      </div>

      <div class="flex flex-col md:items-end justify-center">
        <p class="text-4xl font-bold text-gray-900">₦<%= @company.latest_price || '0.00' %></p>
        <p class="text-sm text-green-600 font-semibold mt-1">▲ +2.4% Today</p>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-gray-200 grid grid-cols-2 md:grid-cols-4 gap-6 relative z-10">
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Market Cap</p>
        <p class="text-xl font-medium text-gray-900 mt-1.5">₦<%= @company.market_cap || 'N/A' %>B</p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">PE Ratio</p>
        <p class="text-xl font-medium text-gray-900 mt-1.5"><%= @company.pe_ratio || 'N/A' %></p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Div Yield</p>
        <p class="text-xl font-medium text-green-600 mt-1.5"><%= @company.dividend_yield || '0.0' %>%</p>
      </div>
      <div>
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wider">52 Wk High</p>
        <p class="text-xl font-medium text-gray-900 mt-1.5">₦<%= @company.high_52_week || 'N/A' %></p>
      </div>
    </div>
  </div>

  <!-- AI Explanation Card -->
  <div class="bg-navy-50 border border-navy-200 rounded-2xl p-6 flex gap-4 items-start relative overflow-hidden group">
    <div class="absolute inset-0 bg-navy-100/30 group-hover:bg-navy-100/50 transition-colors"></div>
    <div class="w-10 h-10 rounded-xl bg-navy-100 border border-navy-300 flex items-center justify-center text-navy-600 shrink-0 relative z-10">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
    </div>
    <div class="relative z-10">
      <h3 class="font-bold text-navy-900">What this means for you</h3>
      <p class="text-sm text-gray-700 mt-1.5 leading-relaxed"><%= @company.pe_ratio_explanation %></p>
    </div>
  </div>

  <!-- Charts Section -->
  <div class="bg-white border border-gray-200 rounded-2xl p-8 relative overflow-hidden shadow-sm">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-gray-900">Price History</h2>
      <% unless premium_user? %>
        <span class="px-3 py-1 bg-gray-100 text-gray-600 text-xs font-semibold rounded-full border border-gray-200">Last 30 Days (Free)</span>
      <% end %>
    </div>
    
    <% if @price_data.any? %>
      <div class="h-80 w-full">
        <%= area_chart(@price_data.map.with_index { |(date, price), idx| ["Day #{idx + 1}", price] }, prefix: "₦", colors: ["#001f3f"], dataset: {backgroundColor: "rgba(0, 31, 63, 0.1)"}) %>
      </div>
    <% else %>
      <div class="h-80 w-full flex items-center justify-center bg-gray-50 rounded-xl border border-dashed border-gray-300">
        <p class="text-gray-500">No price history available.</p>
      </div>
    <% end %>

    <% unless premium_user? %>
      <div class="mt-6 flex items-center justify-between p-4 bg-navy-50 border border-navy-100 rounded-xl">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-navy-200 flex items-center justify-center text-navy-700">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          </div>
          <p class="text-sm font-medium text-navy-900">Unlock full historical price data and advanced dividend analytics.</p>
        </div>
        <%= link_to "Upgrade", pricing_path, class: "px-4 py-2 bg-navy-600 text-white text-sm font-semibold rounded-lg shadow-md hover:bg-navy-700 transition" %>
      </div>
    <% end %>
  </div>

  <!-- Dividend History Chart -->
  <div class="bg-white border border-gray-200 rounded-2xl p-8 relative overflow-hidden shadow-sm">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold text-gray-900">Dividend History</h2>
    </div>
    
    <% dividend_data = @company.dividends.where.not(amount: nil).order(qualification_date: :asc).map { |d| [d.qualification_date&.strftime("%b %Y") || "Unknown", d.amount] } %>
    
    <% if dividend_data.any? %>
      <div class="h-64 w-full">
        <%= column_chart dividend_data, prefix: "₦", colors: ["#d4af37"], dataset: {borderRadius: 4} %>
      </div>
    <% else %>
      <div class="h-64 w-full flex items-center justify-center bg-gray-50 rounded-xl border border-dashed border-gray-300">
        <p class="text-gray-500">No dividend history available.</p>
      </div>
    <% end %>
  </div>
</div>
