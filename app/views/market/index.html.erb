<div class="space-y-8">
  <div class="flex items-center justify-between">
    <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Market Overview</h1>
    <span class="text-sm text-gray-600 bg-gray-50 px-3 py-1.5 rounded-full border border-gray-200">
      Last updated:
      <%= @last_updated_at.present? ? "#{time_ago_in_words(@last_updated_at)} ago" : "No market data yet" %>
    </span>
  </div>

  <% if @market_summary.present? %>
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <div class="bg-white border border-gray-200 p-6 rounded-2xl relative overflow-hidden hover:border-navy-300 transition-colors shadow-sm">
      <div class="absolute -right-4 -top-4 w-24 h-24 bg-navy-200/30 rounded-full"></div>
      <p class="text-sm font-medium text-gray-600 relative z-10">All-Share Index (ASI)</p>
      <p class="mt-2 text-3xl font-bold text-gray-900 relative z-10"><%= number_with_precision(@market_summary[:all_share_index], precision: 2, delimiter: ",") %></p>
      <% average_change = @market_summary[:average_change_percent] %>
      <div class="mt-2 text-sm <%= average_change.to_d.negative? ? 'text-red-600' : 'text-green-600' %> font-semibold relative z-10">
        <%= average_change.to_d.negative? ? "▼" : "▲" %> <%= number_to_percentage(average_change, precision: 2, format: "%n%") %>
      </div>
    </div>
    
    <div class="bg-white border border-gray-200 p-6 rounded-2xl relative overflow-hidden hover:border-navy-300 transition-colors shadow-sm">
      <div class="absolute -right-4 -top-4 w-24 h-24 bg-navy-200/30 rounded-full"></div>
      <p class="text-sm font-medium text-gray-600 relative z-10">Market Cap (₦ Trillion)</p>
      <p class="mt-2 text-3xl font-bold text-gray-900 relative z-10"><%= number_with_precision(@market_summary[:market_cap_trillions], precision: 2, delimiter: ",") %></p>
      <% market_cap_change = @market_summary[:market_cap_change_percent] %>
      <div class="mt-2 text-sm <%= market_cap_change.to_d.negative? ? 'text-red-600' : 'text-green-600' %> font-semibold relative z-10">
        <%= market_cap_change.to_d.negative? ? "▼" : "▲" %> <%= number_to_percentage(market_cap_change, precision: 2, format: "%n%") %>
      </div>
    </div>
    
    <div class="bg-white border border-gray-200 p-6 rounded-2xl relative overflow-hidden hover:border-navy-300 transition-colors shadow-sm">
      <div class="absolute -right-4 -top-4 w-24 h-24 bg-navy-200/30 rounded-full"></div>
      <p class="text-sm font-medium text-gray-600 relative z-10">Volume Traded (M)</p>
      <p class="mt-2 text-3xl font-bold text-gray-900 relative z-10"><%= number_with_precision(@market_summary[:volume_millions], precision: 1, delimiter: ",") %></p>
      <div class="mt-2 text-sm text-gray-600 font-medium relative z-10">Latest session</div>
    </div>
  </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-8">
    <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
      <h2 class="text-xl font-bold text-gray-900 mb-5">Top Gainers</h2>
      <% if @top_gainers.present? && @top_gainers.any? %>
      <div class="space-y-3">
        <% @top_gainers.each do |gainer| %>
          <% company = gainer[:company] %>
          <% change_percent = gainer[:change_percent].to_d %>
          <%= link_to company_path(company.ticker_symbol), class: "flex justify-between items-center p-4 bg-gray-50 rounded-xl border border-gray-200 hover:border-navy-300 hover:shadow-sm transition-colors" do %>
            <div>
              <p class="font-bold text-gray-900"><%= company.ticker_symbol %></p>
              <p class="text-xs text-gray-600"><%= company.name %></p>
            </div>
            <div class="text-right">
              <p class="font-semibold text-gray-900"><%= number_to_currency(gainer[:price], unit: "₦") %></p>
              <p class="text-sm <%= change_percent.negative? ? 'text-red-600' : 'text-green-600' %> font-semibold">
                <%= change_percent.negative? ? "▼" : "▲" %> <%= number_to_percentage(change_percent, precision: 2, format: "%n%") %>
              </p>
            </div>
          <% end %>
        <% end %>
      </div>
      <% else %>
      <div class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center text-sm text-gray-500">
        Top gainers will appear once price changes are available.
      </div>
      <% end %>
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
      <h2 class="text-xl font-bold text-gray-900 mb-5">Market News</h2>
      <% if @market_news.present? && @market_news.any? %>
      <div class="space-y-3">
        <% @market_news.each do |article| %>
          <%= link_to news_article_path(article.slug), class: "block p-4 bg-gray-50 rounded-xl border border-gray-200 hover:border-navy-300 hover:shadow-sm transition-colors" do %>
            <p class="text-xs font-semibold text-navy-600 mb-1.5 uppercase tracking-wider"><%= article.category || "Market" %></p>
            <p class="font-semibold text-gray-900 leading-snug"><%= article.title %></p>
            <p class="text-xs text-gray-600 mt-2"><%= time_ago_in_words(article.published_at) %> ago</p>
          <% end %>
        <% end %>
      </div>
      <% else %>
      <div class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center text-sm text-gray-500">
        Market news will appear once articles are published.
      </div>
      <% end %>
    </div>
  </div>
</div>
