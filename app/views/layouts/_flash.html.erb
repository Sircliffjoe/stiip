<div id="flash" class="fixed top-4 right-4 z-50 flex flex-col gap-3">
  <% flash.each do |key, message| %>
    <% 
      alert_class = case key.to_s
      when 'notice' then 'bg-blue-50 border-blue-300 text-blue-900'
      when 'alert', 'error' then 'bg-red-50 border-red-300 text-red-900'
      when 'success' then 'bg-green-50 border-green-300 text-green-900'
      else 'bg-gray-100 border-gray-300 text-gray-900'
      end
    %>
    <div class="flash-message px-5 py-4 rounded-xl border shadow-lg <%= alert_class %> flex items-start justify-between min-w-[300px]" role="alert">
      <div class="flex items-center gap-3">
        <% if key.to_s == 'success' %>
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <% elsif key.to_s == 'notice' %>
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        <% else %>
          <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <% end %>
        <span class="block sm:inline font-medium"><%= message %></span>
      </div>
      <button class="flash-close ml-4 opacity-70 hover:opacity-100 transition-opacity">
        <svg class="fill-current h-5 w-5" role="button" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
          <path d="M14.348 14.849a1.2 1.2 0 0 1-1.697 0L10 11.819l-2.651 3.029a1.2 1.2 0 1 1-1.697-1.697l2.758-3.15-2.759-3.152a1.2 1.2 0 1 1 1.697-1.697L10 8.183l2.651-3.031a1.2 1.2 0 1 1 1.697 1.697l-2.758 3.152 2.758 3.15a1.2 1.2 0 0 1 0 1.698z"/>
        </svg>
      </button>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    initFlashes();
  });
  
  document.addEventListener('DOMContentLoaded', function() {
    initFlashes();
  });

  function initFlashes() {
    const flashes = document.querySelectorAll('.flash-message');
    
    flashes.forEach(flash => {
      // Auto dismiss after 5 seconds
      setTimeout(() => {
        dismissFlash(flash);
      }, 5000);
      
      // Handle close button click
      const closeBtn = flash.querySelector('.flash-close');
      if (closeBtn) {
        closeBtn.addEventListener('click', () => {
          dismissFlash(flash);
        });
      }
    });
  }

  function dismissFlash(element) {
    if (!element) return;
    element.style.transition = 'opacity 0.5s ease-out, transform 0.5s ease-out';
    element.style.opacity = '0';
    element.style.transform = 'translateY(-10px)';
    
    setTimeout(() => {
      if (element.parentNode) {
        element.parentNode.removeChild(element);
      }
    }, 500);
  }
</script>
