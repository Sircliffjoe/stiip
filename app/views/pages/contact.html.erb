<% content_for(:title, "Contact — NoraCapital") %>

<div class="max-w-4xl mx-auto py-16">
  <div class="text-center mb-16">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-navy-100 border border-navy-200 text-sm font-medium text-navy-700 mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
      Get in Touch
    </div>
    <h1 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight leading-tight mb-6">
      We'd love to <span class="text-navy-700">hear from you</span>
    </h1>
    <p class="text-lg text-gray-600 font-light max-w-2xl mx-auto">Have a question, suggestion, or partnership inquiry? Reach out and our team will get back to you promptly.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
    <div class="bg-white border border-gray-200 rounded-2xl p-8 text-center hover:border-navy-300 hover:shadow-lg transition-all duration-300">
      <div class="w-12 h-12 bg-navy-100 text-navy-600 rounded-xl flex items-center justify-center mx-auto mb-4 border border-navy-200">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
      </div>
      <h3 class="font-bold text-gray-900 mb-1">Email Us</h3>
      <a href="mailto:hello@noracapital.com.ng" class="text-sm text-navy-600 hover:text-navy-700">hello@noracapital.com.ng</a>
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl p-8 text-center hover:border-navy-300 hover:shadow-lg transition-all duration-300">
      <div class="w-12 h-12 bg-navy-100 text-navy-600 rounded-xl flex items-center justify-center mx-auto mb-4 border border-navy-200">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
      </div>
      <h3 class="font-bold text-gray-900 mb-1">Location</h3>
      <p class="text-sm text-gray-600">Lagos, Nigeria</p>
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl p-8 text-center hover:border-navy-300 hover:shadow-lg transition-all duration-300">
      <div class="w-12 h-12 bg-navy-100 text-navy-600 rounded-xl flex items-center justify-center mx-auto mb-4 border border-navy-200">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      </div>
      <h3 class="font-bold text-gray-900 mb-1">Response Time</h3>
      <p class="text-sm text-gray-600">Within 24 hours</p>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl p-10 text-center">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Send us a message</h2>
    <p class="text-gray-600 mb-6">For any inquiries, reach out directly via email:</p>
    <a href="mailto:hello@noracapital.com.ng" class="inline-block px-8 py-4 bg-navy-700 text-white font-bold rounded-xl shadow-lg hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
      hello@noracapital.com.ng
    </a>
  </div>
</div>
