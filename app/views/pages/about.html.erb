<% content_for(:title, "About — NoraCapital") %>

<!-- Hero -->
<div class="relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-navy-200/20 rounded-full filter blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-navy-100/15 rounded-full filter blur-3xl"></div>

  <div class="relative z-10 max-w-4xl mx-auto text-center py-20">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-navy-100 border border-navy-200 text-sm font-medium text-navy-700 mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      Our Story
