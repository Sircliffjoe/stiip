<% content_for(:title, "Features — NoraCapital") %>

<div class="relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-navy-200/20 rounded-full filter blur-3xl"></div>
  <div class="relative z-10 max-w-4xl mx-auto text-center py-20">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-navy-100 border border-navy-200 text-sm font-medium text-navy-700 mb-8">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path></svg>
      Platform Features
    </div>
    <h1 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight leading-tight mb-6">
      Everything you need to invest <span class="text-navy-700">smarter</span>
    </h1>
    <p class="text-lg text-gray-600 font-light max-w-2xl mx-auto leading-relaxed">Powerful tools designed for Nigerian retail investors — from real-time market data to intelligent dividend tracking.</p>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-8">
  <% [
    { icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6", color: "navy", title: "Real-Time Market Data", desc: "Track stock prices, top gainers, losers, and most traded stocks across the Nigerian Exchange." },
    { icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z", color: "navy", title: "Dividend Intelligence", desc: "Never miss a payout. Track upcoming dividends, qualification dates, and yield opportunities." },
    { icon: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4", color: "navy", title: "Company Profiles", desc: "Detailed pages for every NGX-listed company with prices, PE ratios, market cap, and dividend history." },
    { icon: "M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z", color: "gold", title: "Smart Watchlists", desc: "Create personalized watchlists to follow your favourite stocks and get notified about changes." },
    { icon: "M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9", color: "gold", title: "Real-Time Alerts", desc: "Instant in-app notifications for dividend announcements, price movements, and market news." },
    { icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253", color: "navy", title: "Learning Hub", desc: "Beginner-friendly investment guides, stock analyses, and dividend strategies to build confidence." },
    { icon: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z", color: "navy", title: "Market News", desc: "Curated Nigerian market news to keep you informed about the companies and sectors that matter." },
    { icon: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z", color: "navy", title: "Charts & Visualization", desc: "Interactive price charts and dividend trend visualizations to help you see the bigger picture." },
    { icon: "M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z", color: "navy", title: "Global Search", desc: "Instantly find any company, ticker, news article, or educational content across the platform." }
  ].each do |f| %>
    <div class="bg-white border border-gray-200 p-8 rounded-2xl hover:border-<%= f[:color] %>-300 hover:shadow-lg hover:shadow-<%= f[:color] %>-100 hover:-translate-y-1 transition-all duration-300 group">
      <div class="w-12 h-12 bg-<%= f[:color] %>-100 text-<%= f[:color] %>-600 rounded-xl flex items-center justify-center mb-6 border border-<%= f[:color] %>-200 group-hover:bg-<%= f[:color] %>-200 transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= f[:icon] %>"></path></svg>
      </div>
      <h3 class="text-xl font-bold text-gray-900 mb-3"><%= f[:title] %></h3>
      <p class="text-gray-600 font-light leading-relaxed"><%= f[:desc] %></p>
    </div>
  <% end %>
</div>

<div class="mt-20 text-center bg-navy-700 rounded-2xl p-12 shadow-xl">
  <h2 class="text-3xl font-bold text-white mb-4">Ready to take control?</h2>
  <p class="text-navy-200 font-light max-w-xl mx-auto mb-8">Start with a free account and unlock the power of Nigerian stock intelligence.</p>
  <div class="flex flex-col sm:flex-row gap-4 justify-center">
    <a href="/users/sign_up" class="px-8 py-4 bg-white text-navy-700 font-bold rounded-xl shadow-lg hover:-translate-y-1 hover:shadow-xl transition-all duration-300">Get Started Free</a>
    <a href="/pricing" class="px-8 py-4 border border-navy-300 text-white font-semibold rounded-xl hover:bg-navy-700 transition-all duration-300">View Pricing</a>
  </div>
</div>
