<div class="space-y-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Watchlists</h1>
      <p class="mt-1 text-gray-600">Track companies and receive watchlist-driven news alerts.</p>
    </div>

    <%= form_with model: @watchlist, class: "flex gap-2" do |f| %>
      <%= f.text_field :name, placeholder: "New watchlist", class: "w-56 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-purple-500" %>
      <%= f.submit "Create", class: "rounded-lg bg-purple-600 px-4 py-2 text-sm font-semibold text-white hover:bg-purple-700" %>
    <% end %>
  </div>

  <% if @watchlist&.errors&.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <%= @watchlist.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <% if @watchlists.any? %>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% @watchlists.each do |watchlist| %>
        <%= link_to watchlist, class: "block rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:border-purple-300 hover:shadow-md" do %>
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold text-gray-900"><%= watchlist.name %></h2>
              <p class="mt-1 text-sm text-gray-500"><%= pluralize(watchlist.companies.size, "company") %></p>
            </div>
            <% if watchlist.is_default? %>
              <span class="rounded-full bg-purple-50 px-2.5 py-1 text-xs font-medium text-purple-700">Default</span>
            <% end %>
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            <% watchlist.companies.first(6).each do |company| %>
              <span class="rounded-md bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-700"><%= company.ticker_symbol %></span>
            <% end %>
            <% if watchlist.companies.size > 6 %>
              <span class="rounded-md bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-500">+<%= watchlist.companies.size - 6 %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white p-12 text-center">
      <h3 class="text-lg font-medium text-gray-900">No watchlists yet</h3>
      <p class="mt-2 text-gray-500">Create one above to start tracking your favorite stocks.</p>
    </div>
  <% end %>
</div>
