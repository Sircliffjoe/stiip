<div class="mx-auto max-w-xl space-y-6">
  <div>
    <%= link_to "Back to watchlists", watchlists_path, class: "text-sm font-medium text-purple-600 hover:text-purple-700" %>
    <h1 class="mt-2 text-3xl font-bold text-gray-900">New Watchlist</h1>
  </div>

  <%= form_with model: @watchlist, class: "rounded-lg border border-gray-200 bg-white p-6 shadow-sm space-y-4" do |f| %>
    <% if @watchlist.errors.any? %>
      <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
        <%= @watchlist.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "mt-1 w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-purple-500" %>
    </div>

    <%= f.submit "Create Watchlist", class: "rounded-lg bg-purple-600 px-4 py-2 text-sm font-semibold text-white hover:bg-purple-700" %>
  <% end %>
</div>
