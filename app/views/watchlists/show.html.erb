<div class="space-y-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <%= link_to "Watchlists", watchlists_path, class: "text-sm font-medium text-navy-600 hover:text-navy-700" %>
      <h1 class="mt-2 text-3xl font-bold text-gray-900 tracking-tight"><%= @watchlist.name %></h1>
      <p class="mt-1 text-gray-600"><%= pluralize(@watchlist_items.size, "tracked company") %></p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Rename", edit_watchlist_path(@watchlist), class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
      <%= button_to "Delete", @watchlist, method: :delete, class: "rounded-lg border border-red-200 px-4 py-2 text-sm font-semibold text-red-600 hover:bg-red-50", form: { data: { turbo_confirm: "Delete this watchlist?" } } %>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-[1fr_22rem]">
    <div class="rounded-lg border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-5 py-4">
        <h2 class="font-semibold text-gray-900">Companies</h2>
      </div>
      <% if @watchlist_items.any? %>
        <div class="divide-y divide-gray-100">
          <% @watchlist_items.each do |item| %>
            <% company = item.company %>
            <div class="flex flex-col gap-4 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <%= link_to company.ticker_symbol, company_path(company.ticker_symbol), class: "font-semibold text-navy-700 hover:text-navy-800" %>
                <p class="text-sm text-gray-600"><%= company.name %></p>
                <p class="mt-1 text-xs text-gray-500"><%= company.sector&.name %></p>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-right">
                  <p class="font-semibold text-gray-900"><%= number_to_currency(company.latest_price || 0, unit: "₦") %></p>
                  <p class="text-xs text-gray-500">Latest price</p>
                </div>
                <%= button_to "Remove", watchlist_watchlist_item_path(@watchlist, item), method: :delete, class: "rounded-lg border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="p-10 text-center text-gray-500">No companies in this watchlist yet.</div>
      <% end %>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
      <h2 class="font-semibold text-gray-900">Add Company</h2>
      <% if current_access_policy.can_add_watchlist_item? %>
        <%= form_with url: watchlist_watchlist_items_path(@watchlist), method: :post, class: "mt-4 space-y-4" do |f| %>
          <%= select_tag :company_id, options_from_collection_for_select(@companies, :id, :ticker_symbol), class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-navy-500 focus:ring-navy-500" %>
          <%= f.submit "Add to Watchlist", class: "w-full rounded-lg bg-navy-600 px-4 py-2 text-sm font-semibold text-white hover:bg-navy-700" %>
        <% end %>
      <% else %>
        <div class="mt-4 rounded-lg border border-navy-100 bg-navy-50 p-4">
          <p class="text-sm text-navy-900">Free users can track up to 5 stocks. Upgrade to Premium for unlimited watchlist stocks.</p>
          <%= link_to "Upgrade to Premium", pricing_path, class: "mt-3 inline-block rounded-lg bg-navy-700 px-4 py-2 text-sm font-semibold text-white hover:bg-navy-800" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
