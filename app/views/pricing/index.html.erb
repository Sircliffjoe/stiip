<% content_for(:title, "Pricing — NoraCapital") %>

<!-- Hero -->
<div class="text-center py-16 relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-navy-200/30 rounded-full filter blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-navy-100/20 rounded-full filter blur-3xl"></div>

  <div class="relative z-10 max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-navy-100 border border-navy-200 text-sm font-medium text-navy-700 mb-6">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      Simple, transparent pricing
    </div>
    <h1 class="text-4xl sm:text-5xl font-black text-gray-900 tracking-tight leading-tight mb-4">
      Choose the plan that
      <span class="text-navy-700">fits your goals</span>
    </h1>
    <p class="text-lg text-gray-600 font-light max-w-2xl mx-auto">
      Start free, upgrade when you're ready. No hidden fees, cancel anytime.
    </p>
  </div>
</div>

<!-- Plans Grid -->
<div class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 pb-20">
  <% @plans.each do |plan| %>
    <div class="relative bg-white border <%= plan[:highlighted] ? 'border-navy-300 shadow-xl ring-2 ring-navy-200' : 'border-gray-200 shadow-sm' %> rounded-2xl p-8 flex flex-col hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
      <% if plan[:highlighted] %>
        <div class="absolute -top-4 left-1/2 -translate-x-1/2">
          <span class="px-4 py-1.5 bg-navy-700 text-white text-xs font-bold rounded-full shadow-lg uppercase tracking-wider">
            Most Popular
          </span>
        </div>
      <% end %>

      <div class="mb-6">
        <h3 class="text-xl font-bold text-gray-900 mb-1"><%= plan[:name] %></h3>
        <p class="text-sm text-gray-500"><%= plan[:description] %></p>
      </div>

      <div class="mb-8">
        <% if plan[:price] == 0 %>
          <span class="text-4xl font-black text-gray-900">Free</span>
          <span class="text-gray-500 text-sm ml-1">/ <%= plan[:period] %></span>
        <% else %>
          <span class="text-4xl font-black text-gray-900">₦<%= number_with_delimiter(plan[:price]) %></span>
          <span class="text-gray-500 text-sm ml-1">/ <%= plan[:period] %></span>
        <% end %>
      </div>

      <ul class="space-y-3 mb-8 flex-grow">
        <% plan[:features].each do |feature| %>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 <%= plan[:highlighted] ? 'text-navy-600' : 'text-navy-500' %> shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span class="text-sm text-gray-700"><%= feature %></span>
          </li>
        <% end %>
      </ul>

      <% if plan[:highlighted] %>
        <% if user_signed_in? && current_user.premium_role? %>
          <div class="w-full py-3.5 bg-gray-100 text-gray-500 font-semibold rounded-xl text-center text-sm">
            ✓ Current Plan
          </div>
        <% else %>
          <%= button_to plan[:cta] || "Upgrade to Premium",
              "/pricing/checkout",
              method: :post,
              class: "w-full py-3.5 bg-navy-700 text-white font-bold rounded-xl text-center shadow-lg hover:-translate-y-0.5 hover:shadow-xl hover:shadow-navy-600/30 transition-all duration-300 text-sm" %>
        <% end %>
      <% else %>
        <% if user_signed_in? %>
          <div class="w-full py-3.5 bg-gray-100 text-gray-500 font-semibold rounded-xl text-center text-sm">
            ✓ Current Plan
          </div>
        <% else %>
          <%= link_to plan[:cta],
              plan[:cta_path],
              class: "w-full py-3.5 bg-white border border-gray-300 text-gray-900 font-semibold rounded-xl text-center hover:border-navy-300 hover:bg-navy-50 transition-all duration-300 block text-sm" %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>

<!-- FAQ -->
<div class="max-w-3xl mx-auto pb-20">
  <h2 class="text-2xl font-bold text-gray-900 text-center mb-10">Frequently Asked Questions</h2>
  <div class="space-y-4">
    <div class="bg-white border border-gray-200 rounded-xl p-6">
      <h3 class="font-semibold text-gray-900 mb-2">Can I cancel anytime?</h3>
      <p class="text-sm text-gray-600">Yes. You can cancel your Premium subscription at any time. You'll retain access until the end of your billing period.</p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl p-6">
      <h3 class="font-semibold text-gray-900 mb-2">What payment methods do you accept?</h3>
      <p class="text-sm text-gray-600">We accept all major cards, bank transfers, and USSD payments through our payment partner, Paystack.</p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl p-6">
      <h3 class="font-semibold text-gray-900 mb-2">Is my data secure?</h3>
      <p class="text-sm text-gray-600">Absolutely. We never store your card details. All payments are processed securely by Paystack, which is PCI-DSS compliant.</p>
    </div>
  </div>
</div>
