<article class="mx-auto max-w-3xl space-y-8">
  <div>
    <%= link_to "Market News", news_articles_path, class: "text-sm font-medium text-navy-600 hover:text-navy-700" %>
    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-gray-500">
      <span class="rounded-full bg-navy-50 px-3 py-1 font-medium text-navy-700"><%= @article.category || "Market" %></span>
      <% if @article.source.present? %>
        <span><%= @article.source %></span>
      <% end %>
      <% if @article.published_at.present? %>
        <span><%= @article.published_at.strftime("%b %-d, %Y") %></span>
      <% end %>
    </div>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900"><%= @article.title %></h1>
    <div class="mt-5 space-y-4 text-lg leading-8 text-gray-700">
      <% @article.summary.to_s.split(/\n{2,}/).each do |paragraph| %>
        <p><%= paragraph %></p>
      <% end %>
    </div>
  </div>

  <% if @article.companies.any? %>
    <div class="rounded-lg border border-gray-200 bg-white p-5">
      <h2 class="font-semibold text-gray-900">Related Companies</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        <% @article.companies.each do |company| %>
          <%= link_to company.ticker_symbol, company_path(company.ticker_symbol), class: "rounded-md bg-gray-100 px-2.5 py-1 text-sm font-semibold text-gray-700 hover:bg-navy-50 hover:text-navy-700" %>
        <% end %>
      </div>
    </div>
  <% end %>

  <footer class="border-t border-gray-200 pt-5 text-sm text-gray-500">
    Source:
    <% if @article.source_url.present? %>
      <%= link_to(@article.source.presence || @article.source_url, @article.source_url, target: "_blank", rel: "noopener", class: "font-medium text-navy-700 hover:text-navy-800") %>
    <% else %>
      <span class="font-medium"><%= @article.source.presence || "Unknown" %></span>
    <% end %>
  </footer>

  <% if @related_articles.any? %>
    <section class="border-t border-gray-200 pt-6">
      <h2 class="font-semibold text-gray-900">More in <%= @article.category %></h2>
      <div class="mt-4 space-y-3">
        <% @related_articles.each do |article| %>
          <%= link_to article.title, news_article_path(article), class: "block rounded-lg border border-gray-200 bg-white p-4 font-medium text-gray-900 hover:border-navy-300" %>
        <% end %>
      </div>
    </section>
  <% end %>
</article>
