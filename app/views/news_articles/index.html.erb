<div class="space-y-8">
  <div>
    <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Market News</h1>
    <p class="mt-1 text-gray-600">Company updates, market moves, and macro signals for Nigerian investors.</p>
  </div>

  <% if @featured_article %>
    <%= link_to news_article_path(@featured_article), class: "block rounded-lg border border-purple-200 bg-purple-50 p-6 transition hover:border-purple-300" do %>
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <span class="text-sm font-semibold text-purple-700">Featured <%= @featured_article.category %></span>
          <h2 class="mt-2 text-2xl font-bold text-gray-900"><%= @featured_article.title %></h2>
          <p class="mt-3 max-w-3xl text-gray-700"><%= @featured_article.summary %></p>
        </div>
        <span class="text-sm font-medium text-purple-700"><%= time_ago_in_words(@featured_article.published_at) %> ago</span>
      </div>
    <% end %>
  <% end %>

  <% if @categories.any? %>
    <div class="flex flex-wrap gap-2">
      <% @categories.each do |category| %>
        <span class="rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700"><%= category %></span>
      <% end %>
    </div>
  <% end %>

  <% if @articles.any? %>
    <div class="grid gap-4 md:grid-cols-2">
      <% @articles.each do |article| %>
        <%= link_to news_article_path(article), class: "block rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:border-purple-300 hover:shadow-md" do %>
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-semibold text-purple-700"><%= article.category || "Market" %></span>
            <span class="text-xs text-gray-500"><%= article.source %></span>
          </div>
          <h2 class="mt-3 text-lg font-semibold text-gray-900"><%= article.title %></h2>
          <p class="mt-2 line-clamp-3 text-sm leading-6 text-gray-600"><%= article.summary %></p>
          <div class="mt-4 flex flex-wrap gap-2">
            <% article.companies.first(4).each do |company| %>
              <span class="rounded-md bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-700"><%= company.ticker_symbol %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white p-12 text-center text-gray-500">
      News articles will appear here once published.
    </div>
  <% end %>
</div>
