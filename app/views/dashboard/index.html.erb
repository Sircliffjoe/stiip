<div class="space-y-8">
  <div>
    <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Dashboard</h1>
    <p class="mt-1 text-gray-600">Welcome back, <span class="text-gray-900 font-medium"><%= current_user.first_name %></span>.</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="col-span-2 bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-xl font-bold text-gray-900">Your Watchlists</h2>
        <button class="text-sm font-medium text-navy-600 hover:text-navy-700">View all</button>
      </div>
      
      <% if @watchlists.empty? %>
        <div class="text-center py-12 border border-dashed border-gray-300 rounded-xl bg-gray-50">
          <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
          </div>
          <p class="text-gray-600 mb-4">You aren't tracking any stocks yet.</p>
          <%= link_to "Create Watchlist", watchlists_path, class: "inline-block px-4 py-2 bg-navy-600 text-white rounded-lg hover:bg-navy-700 transition font-medium" %>
        </div>
      <% else %>
        <div class="space-y-3">
          <% @watchlists.each do |list| %>
            <%= link_to watchlist_path(list), class: "p-4 bg-gray-50 rounded-xl border border-gray-200 hover:border-navy-300 hover:shadow-md transition-all flex justify-between items-center group cursor-pointer" do %>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-white border border-gray-300 flex items-center justify-center text-navy-600 group-hover:bg-navy-50 transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
                </div>
                <span class="font-medium text-gray-900 group-hover:text-navy-600 transition-colors"><%= list.name %></span>
              </div>
              <span class="text-sm font-medium bg-gray-100 text-gray-700 px-2.5 py-1 rounded-md border border-gray-200"><%= list.watchlist_items.count %> items</span>
            <% end %>
            </a>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
      <h2 class="text-xl font-bold text-gray-900 mb-6">Smart Insights</h2>
      <div class="p-5 bg-navy-700 rounded-xl border border-navy-200 relative overflow-hidden group">
        <div class="absolute inset-0 bg-navy-100/20 group-hover:bg-navy-100/30 transition-colors"></div>
        <div class="flex items-start gap-4 relative z-10">
          <div class="mt-0.5 w-8 h-8 rounded-lg bg-navy-100 border border-navy-300 flex items-center justify-center text-navy-600 shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          </div>
          <div>
            <p class="font-bold text-white">High Yield Alert</p>
            <p class="text-sm text-gray-700 mt-1.5 leading-relaxed">Zenith Bank's current price brings its dividend yield to <span class="text-navy-600 font-semibold">12.5%</span>, significantly above the sector average.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
