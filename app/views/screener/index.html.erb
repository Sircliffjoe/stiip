<% content_for(:title, "Smart Screener — NoraCapital") %>

<% if @locked_feature %>
  <%= render "shared/locked_feature",
    title: user_signed_in? ? "Smart Screener requires Premium" : "Log in to access the Smart Screener",
    message: user_signed_in? ? "The screener is a Premium feature for filtering, comparing, and ranking stocks by fundamentals, performance, dividends, and signals." : "You must be logged in before accessing advanced market analytics.",
    cta_label: user_signed_in? ? "Upgrade to Premium" : "Log in",
    cta_path: user_signed_in? ? pricing_path : new_user_session_path,
    secondary_label: user_signed_in? ? nil : "Create free account",
    secondary_path: new_user_registration_path %>
<% else %>

<!-- Header -->
<div class="relative overflow-hidden mb-12">
  <div class="absolute top-0 right-0 w-80 h-80 bg-navy-200/10 rounded-full filter blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-72 h-72 bg-gold-100/10 rounded-full filter blur-3xl"></div>

  <div class="relative z-10 py-6">
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-navy-100/80 border border-navy-200 text-xs font-semibold text-navy-800 mb-6">
      <svg class="w-3.5 h-3.5 text-gold-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
      Advanced Market Analytics
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight leading-tight">
      Smart <span class="text-navy-700">Screener</span>
    </h1>
    <p class="text-gray-600 font-light mt-2 max-w-xl">
      Filter, compare, and analyze companies across the NGX and US markets by fundamentals, performance, and signals.
    </p>
  </div>
</div>

<!-- Filters Panel -->
<div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm mb-8">
  <%= form_with url: screener_path, method: :get, local: true, class: "space-y-6" do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-6 gap-4">
      <!-- Search -->
      <div class="col-span-1 md:col-span-3 lg:col-span-2">
        <%= f.label :search, "Search stock", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2" %>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <%= f.text_field :search, value: params[:search], placeholder: "Search name or ticker...", class: "block w-full pl-9 pr-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-navy-600 focus:border-navy-600 transition-colors" %>
        </div>
      </div>

      <!-- Market / Country -->
      <div>
        <%= f.label :market, "Market", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2" %>
        <%= f.select :market, [["All Markets", ""], ["NGX (Nigeria)", "ngx"], ["US Market", "us"]], { selected: params[:market] }, class: "block w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-navy-600 focus:border-navy-600 transition-colors" %>
      </div>

      <!-- Sector -->
      <div>
        <%= f.label :sector_id, "Sector", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2" %>
        <%= f.select :sector_id, [["All Sectors", ""]] + @sectors.map { |s| [s.name, s.id] }, { selected: params[:sector_id] }, class: "block w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-navy-600 focus:border-navy-600 transition-colors" %>
      </div>

      <!-- Signal -->
      <div>
        <%= f.label :signal, "Signal", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2" %>
        <%= f.select :signal, [["All Signals", ""], ["Buy", "buy"], ["Hold", "hold"], ["Sell", "sell"]], { selected: params[:signal] }, class: "block w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-navy-600 focus:border-navy-600 transition-colors" %>
      </div>

      <!-- Dividend Status -->
      <div>
        <%= f.label :dividend_status, "Dividend", class: "block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2" %>
        <%= f.select :dividend_status, [["All", ""], ["Yielding", "yielding"], ["Non-yielding", "non_yielding"]], { selected: params[:dividend_status] }, class: "block w-full px-3 py-2.5 border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-navy-600 focus:border-navy-600 transition-colors" %>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-gray-100">
      <!-- YTD filter & Sort options -->
      <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto">
        <div class="flex items-center gap-2">
          <%= f.label :ytd, "YTD Return:", class: "text-xs font-semibold text-gray-500 uppercase tracking-wider" %>
          <%= f.select :ytd, [["All Returns", ""], ["Positive (> 0%)", "positive"], ["High (>= 15%)", "high"], ["Negative (< 0%)", "negative"]], { selected: params[:ytd] }, class: "px-3 py-1.5 border border-gray-300 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-navy-600 transition-colors" %>
        </div>
      </div>

      <!-- Buttons -->
      <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
        <a href="<%= screener_path %>" class="px-4 py-2 border border-gray-300 text-gray-700 text-sm font-semibold rounded-xl hover:bg-gray-50 transition-colors">
          Reset Filters
        </a>
        <%= f.submit "Apply Filters", class: "px-5 py-2 bg-navy-700 hover:bg-navy-800 text-white text-sm font-bold rounded-xl shadow-md transition-colors cursor-pointer" %>
      </div>
    </div>
  <% end %>
</div>

<!-- Results -->
<div class="bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm">
  <div class="px-6 py-4 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
    <div class="text-sm text-gray-500 font-medium">
      Showing <span class="font-bold text-gray-900"><%= @companies.size %></span> matching stocks
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead>
        <tr class="bg-gray-50">
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">
            <%= link_to screener_path(request.query_parameters.merge(sort: 'name', direction: params[:sort] == 'name' && params[:direction] == 'asc' ? 'desc' : 'asc')), class: "group inline-flex items-center gap-1 hover:text-gray-900" do %>
              Company
              <svg class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            <% end %>
          </th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Market</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Sector</th>
          <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">
            <%= link_to screener_path(request.query_parameters.merge(sort: 'current_price', direction: params[:sort] == 'current_price' && params[:direction] == 'asc' ? 'desc' : 'asc')), class: "group inline-flex items-center gap-1 hover:text-gray-900 justify-end w-full" do %>
              Price
              <svg class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            <% end %>
          </th>
          <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">
            <%= link_to screener_path(request.query_parameters.merge(sort: 'ytd_return', direction: params[:sort] == 'ytd_return' && params[:direction] == 'asc' ? 'desc' : 'asc')), class: "group inline-flex items-center gap-1 hover:text-gray-900 justify-end w-full" do %>
              YTD Return
              <svg class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            <% end %>
          </th>
          <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">
            <%= link_to screener_path(request.query_parameters.merge(sort: 'dividend_yield', direction: params[:sort] == 'dividend_yield' && params[:direction] == 'asc' ? 'desc' : 'asc')), class: "group inline-flex items-center gap-1 hover:text-gray-900 justify-end w-full" do %>
              Div Yield
              <svg class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            <% end %>
          </th>
          <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Revenue</th>
          <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Net Profit</th>
          <th class="px-6 py-3 text-center text-xs font-bold text-gray-500 uppercase tracking-wider">Signal</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% if @companies.any? %>
          <% @companies.each do |c| %>
            <tr class="hover:bg-gray-50/70 transition-colors">
              <td class="px-6 py-4.5 whitespace-nowrap">
                <a href="<%= company_path(c.ticker_symbol) %>" class="group block">
                  <div class="font-bold text-gray-900 group-hover:text-navy-700 transition-colors"><%= c.name %></div>
                  <div class="text-xs text-gray-500 mt-0.5"><%= c.ticker_symbol %></div>
                </a>
              </td>
              <td class="px-6 py-4.5 whitespace-nowrap">
                <% if c.country == "US" %>
                  <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded bg-navy-50 text-navy-700 text-xs font-semibold border border-navy-100">
                    🇺🇸 US Stock
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1.5 px-2 py-1 rounded bg-navy-50 text-navy-700 text-xs font-semibold border border-navy-100">
                    🇳🇬 NGX
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4.5 whitespace-nowrap text-sm text-gray-600 font-light">
                <%= c.sector&.name || "N/A" %>
              </td>
              <td class="px-6 py-4.5 whitespace-nowrap text-right text-sm font-semibold text-gray-900">
                <%= number_to_currency(c.current_price, unit: c.country == "US" ? "$" : "₦", precision: 2) %>
              </td>
              <td class="px-6 py-4.5 whitespace-nowrap text-right text-sm font-semibold">
                <% if c.ytd_return.to_f > 0 %>
                  <span class="text-navy-600">+<%= number_with_precision(c.ytd_return, precision: 2) %>%</span>
                <% elsif c.ytd_return.to_f < 0 %>
                  <span class="text-red-500"><%= number_with_precision(c.ytd_return, precision: 2) %>%</span>
                <% else %>
                  <span class="text-gray-500">0.00%</span>
                <% end %>
              </td>
              <td class="px-6 py-4.5 whitespace-nowrap text-right text-sm font-semibold text-gray-900">
                <%= c.dividend_yield.to_f > 0 ? "#{number_with_precision(c.dividend_yield, precision: 2)}%" : "—" %>
              </td>
              <td class="px-6 py-4.5 whitespace-nowrap text-right text-sm font-medium text-gray-700">
                <%= c.revenue ? number_to_human_size(c.revenue, units: { thousand: "K", million: "M", billion: "B" }).gsub("Bytes", "") : "—" %>
              </td>
              <td class="px-6 py-4.5 whitespace-nowrap text-right text-sm font-medium text-gray-700">
                <%= c.net_profit ? number_to_human_size(c.net_profit, units: { thousand: "K", million: "M", billion: "B" }).gsub("Bytes", "") : "—" %>
              </td>
              <td class="px-6 py-4.5 whitespace-nowrap text-center">
                <% if c.buy? %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-navy-100 text-navy-800 text-xs font-bold border border-navy-200">
                    BUY
                  </span>
                <% elsif c.sell? %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-red-100 text-red-800 text-xs font-bold border border-red-200">
                    SELL
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-gray-100 text-gray-800 text-xs font-bold border border-gray-200">
                    HOLD
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="9" class="px-6 py-12 text-center text-sm text-gray-500 font-light">
              <svg class="mx-auto h-10 w-10 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              No stocks matching your criteria found. Try resetting filters.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% end %>
