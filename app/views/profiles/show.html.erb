<div class="mx-auto max-w-4xl space-y-8">
  <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-4">
        <div class="flex h-16 w-16 items-center justify-center rounded-full bg-navy-700 text-2xl font-bold text-navy-950 shadow-lg shadow-navy-200">
          <%= @user.first_name.to_s.first&.upcase || "U" %>
        </div>
        <div>
          <h1 class="text-2xl font-bold text-gray-900"><%= @user.full_name %></h1>
          <p class="mt-1 text-sm text-gray-500"><%= @user.email %></p>
          <p class="mt-2 inline-flex rounded-full bg-navy-50 px-3 py-1 text-xs font-semibold text-navy-700"><%= @user.role.humanize %></p>
        </div>
      </div>
      <%= link_to "Edit Settings", settings_path, class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-gray-500">Watchlists</p>
      <p class="mt-2 text-3xl font-bold text-gray-900"><%= @watchlists_count %></p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-gray-500">Unread Notifications</p>
      <p class="mt-2 text-3xl font-bold text-gray-900"><%= @notifications_count %></p>
    </div>
    <div class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm">
      <p class="text-sm font-medium text-gray-500">Member Since</p>
      <p class="mt-2 text-3xl font-bold text-gray-900"><%= @user.created_at.strftime("%Y") %></p>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <%= link_to dashboard_path, class: "rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:border-navy-300 hover:shadow-md" do %>
      <h2 class="font-semibold text-gray-900">Dashboard</h2>
      <p class="mt-1 text-sm text-gray-500">Review your portfolio overview and market insights.</p>
    <% end %>
    <%= link_to watchlists_path, class: "rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:border-navy-300 hover:shadow-md" do %>
      <h2 class="font-semibold text-gray-900">Watchlists</h2>
      <p class="mt-1 text-sm text-gray-500">Manage tracked companies and watchlist alerts.</p>
    <% end %>
  </div>
</div>
