<div class="space-y-6 max-w-2xl mx-auto">
  <div>
    <%= link_to "Back to profile", profile_path, class: "text-sm font-medium text-navy-600 hover:text-navy-700" %>
    <h1 class="mt-2 text-3xl font-bold text-slate-900">Profile Settings</h1>
  </div>
  <div class="rounded-lg border border-gray-200 bg-white p-8 shadow-sm">
    <dl class="space-y-4">
      <div>
        <dt class="text-sm font-medium text-gray-500">Name</dt>
        <dd class="mt-1 text-gray-900"><%= @user.full_name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Email</dt>
        <dd class="mt-1 text-gray-900"><%= @user.email %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500">Role</dt>
        <dd class="mt-1 text-gray-900"><%= @user.role.humanize %></dd>
      </div>
    </dl>
  </div>
</div>
