<div class="space-y-8">

  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>      
      <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Profile Settings</h1>
      <p class="mt-1 text-gray-600">Update your account details and password.</p>
    </div>
    <%= link_to "Back to profile", profile_path, class: "text-sm font-medium text-navy-600 hover:text-navy-700" %>
  </div>

  <%= render "shared/account_nav" if user_signed_in? && !devise_controller? %>

  <div class="rounded-lg border border-gray-200 bg-white p-8 shadow-sm">
    <%= form_with model: @user, url: settings_path, method: :patch, class: "space-y-5" do |form| %>
      <% if @user.errors.any? %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700">
          <%= @user.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :first_name, class: "mb-2 block text-sm font-semibold text-gray-700" %>
          <%= form.text_field :first_name, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-navy-500 focus:ring-navy-500" %>
        </div>
        <div>
          <%= form.label :last_name, class: "mb-2 block text-sm font-semibold text-gray-700" %>
          <%= form.text_field :last_name, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-navy-500 focus:ring-navy-500" %>
        </div>
      </div>

      <div>
        <%= form.label :email, class: "mb-2 block text-sm font-semibold text-gray-700" %>
        <%= form.email_field :email, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-navy-500 focus:ring-navy-500" %>
      </div>

      <div>
        <%= form.label :phone, class: "mb-2 block text-sm font-semibold text-gray-700" %>
        <%= form.telephone_field :phone, class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-navy-500 focus:ring-navy-500" %>
      </div>

      <div class="border-t border-gray-200 pt-5">
        <h2 class="text-sm font-bold text-gray-900">Change password</h2>
        <p class="mt-1 text-sm text-gray-500">Leave these fields blank to keep your current password.</p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= form.label :password, "New password", class: "mb-2 block text-sm font-semibold text-gray-700" %>
          <%= form.password_field :password, autocomplete: "new-password", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-navy-500 focus:ring-navy-500" %>
        </div>
        <div>
          <%= form.label :password_confirmation, class: "mb-2 block text-sm font-semibold text-gray-700" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-navy-500 focus:ring-navy-500" %>
        </div>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= form.submit "Save Settings", class: "rounded-lg bg-navy-700 px-5 py-2.5 text-sm font-bold text-white hover:bg-navy-800" %>
        <%= link_to "Cancel", profile_path, class: "rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700 hover:bg-gray-50" %>
      </div>
    <% end %>
  </div>
</div>
