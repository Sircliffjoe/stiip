<div class="mx-auto max-w-3xl space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <%= link_to "News CMS", admin_news_articles_path, class: "text-sm font-medium text-navy-300 hover:text-navy-200" %>
      <h1 class="mt-2 text-2xl font-bold text-white"><%= @article.title %></h1>
      <p class="mt-2 text-sm text-gray-400"><%= @article.category %> · <%= @article.source %></p>
    </div>
    <%= link_to "Edit", edit_admin_news_article_path(@article), class: "rounded-lg bg-navy-600 px-4 py-2 text-sm font-semibold text-white hover:bg-navy-500" %>
  </div>

  <% if @article.image.attached? %>
    <div class="overflow-hidden rounded-xl border border-gray-800">
      <img src="<%= rails_blob_path(@article.image, only_path: true) %>" alt="<%= @article.title %>" class="w-full max-h-96 object-cover">
    </div>
  <% end %>

  <div class="rounded-lg border border-gray-800 bg-gray-900 p-6">
    <p class="leading-7 text-gray-300"><%= @article.summary %></p>
    <div class="mt-5 flex flex-wrap gap-2">
      <% @article.companies.each do |company| %>
        <span class="rounded-md bg-gray-800 px-2.5 py-1 text-xs font-semibold text-gray-300"><%= company.ticker_symbol %></span>
      <% end %>
    </div>
  </div>

  <%= button_to "Delete Article", admin_news_article_path(@article), method: :delete, class: "rounded-lg border border-red-500/30 px-4 py-2 text-sm font-semibold text-red-300 hover:bg-red-500/10", form: { data: { turbo_confirm: "Delete this article?" } } %>
</div>
