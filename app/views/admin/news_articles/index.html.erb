<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-white">News CMS</h1>
      <p class="mt-1 text-sm text-gray-400">Create and publish market news.</p>
    </div>
    <%= link_to "New Article", new_admin_news_article_path, class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500" %>
  </div>

  <div class="overflow-hidden rounded-lg border border-gray-800 bg-gray-900">
    <% if @articles.any? %>
      <table class="min-w-full divide-y divide-gray-800">
        <thead class="bg-gray-950/60">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-400">Title</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-400">Category</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-400">Status</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-400">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
          <% @articles.each do |article| %>
            <tr>
              <td class="px-4 py-4">
                <p class="font-medium text-white"><%= article.title %></p>
                <p class="mt-1 text-xs text-gray-400"><%= article.source %></p>
              </td>
              <td class="px-4 py-4 text-sm text-gray-300"><%= article.category %></td>
              <td class="px-4 py-4">
                <% if article.published? %>
                  <span class="rounded-full bg-emerald-500/10 px-2.5 py-1 text-xs font-medium text-emerald-300">Published</span>
                <% else %>
                  <span class="rounded-full bg-gray-800 px-2.5 py-1 text-xs font-medium text-gray-300">Draft</span>
                <% end %>
              </td>
              <td class="px-4 py-4 text-right text-sm">
                <%= link_to "View", admin_news_article_path(article), class: "font-medium text-emerald-300 hover:text-emerald-200" %>
                <%= link_to "Edit", edit_admin_news_article_path(article), class: "ml-3 font-medium text-gray-300 hover:text-white" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="p-10 text-center text-gray-400">No news articles yet.</div>
    <% end %>
  </div>
</div>
