<div class="max-w-4xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-white">Dividend Details</h1>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_admin_dividend_path(@dividend), class: "bg-purple-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-purple-700 transition" %>
      <%= link_to "Back to Directory", admin_dividends_path, class: "bg-gray-800 border border-gray-700 text-gray-300 px-4 py-2 rounded-md text-sm font-medium hover:bg-gray-700 transition" %>
    </div>
  </div>

  <div class="bg-gray-900 border border-gray-800 shadow rounded-lg overflow-hidden">
    <div class="px-4 py-5 sm:px-6 flex justify-between items-center border-b border-gray-800">
      <div>
        <h3 class="text-lg leading-6 font-medium text-white flex items-center gap-2">
          <%= @dividend.company.name %> (<%= @dividend.company.ticker_symbol %>)
        </h3>
        <p class="mt-1 max-w-2xl text-sm text-gray-400">
          Financial Year: <%= @dividend.year %>
        </p>
      </div>
      <div class="flex gap-2">
        <span class="px-3 py-1 rounded-full text-sm font-medium <%= @dividend.interim? ? 'bg-blue-900/30 text-blue-400 border border-blue-800' : 'bg-purple-900/30 text-purple-400 border border-purple-800' %>">
          <%= @dividend.interim? ? "Interim" : "Final" %>
        </span>
        <span class="px-3 py-1 rounded-full text-sm font-medium 
          <%= case @dividend.status
              when 'paid' then 'bg-green-900/30 text-green-400 border border-green-800'
              when 'cancelled' then 'bg-red-900/30 text-red-400 border border-red-800'
              else 'bg-amber-900/30 text-amber-400 border border-amber-800'
              end %>">
          <%= @dividend.status.titleize %>
        </span>
      </div>
    </div>
    <div class="border-t border-gray-800 px-4 py-5 sm:p-0">
      <dl class="sm:divide-y sm:divide-gray-800">
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-400">Amount</dt>
          <dd class="mt-1 text-xl font-bold text-white sm:mt-0 sm:col-span-2">
            <%= number_to_currency(@dividend.amount, unit: @dividend.currency || "₦") %>
          </dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-400">Qualification Date</dt>
          <dd class="mt-1 text-sm text-white sm:mt-0 sm:col-span-2">
            <%= @dividend.qualification_date&.strftime("%B %d, %Y") || "Not Set" %>
          </dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-400">Payment Date</dt>
          <dd class="mt-1 text-sm text-white sm:mt-0 sm:col-span-2">
            <%= @dividend.payment_date&.strftime("%B %d, %Y") || "Not Set" %>
          </dd>
        </div>
        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-400">Created At</dt>
          <dd class="mt-1 text-sm text-gray-400 sm:mt-0 sm:col-span-2">
            <%= @dividend.created_at.strftime("%b %d, %Y") %>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</div>
