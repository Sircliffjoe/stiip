<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-white">Dividends Management</h1>
  <%= link_to "Add Dividend", new_admin_dividend_path, class: "bg-navy-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-navy-700 transition" %>
</div>

<div class="overflow-x-auto rounded-xl border border-gray-800 bg-gray-900 shadow">
  <table class="min-w-full divide-y divide-gray-800">
    <thead class="bg-gray-950">
      <tr>
        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Company</th>
        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Amount</th>
        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Type</th>
        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Status</th>
        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Key Dates</th>
        <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-400 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-800 bg-gray-900">
      <% @dividends.each do |dividend| %>
        <tr class="hover:bg-gray-800/50 transition-colors">
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm font-medium text-white"><%= dividend.company.name %></div>
            <div class="text-sm text-gray-400"><%= dividend.company.ticker_symbol %></div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="text-sm text-white font-medium">
              <%= number_to_currency(dividend.amount, unit: dividend.currency || "₦") %>
            </div>
            <div class="text-xs text-gray-400">Year: <%= dividend.year %></div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <% if dividend.interim? %>
              <span class="px-2.5 py-1 inline-flex text-xs font-semibold rounded-full bg-navy-900/30 text-navy-400 border border-navy-800">Interim</span>
            <% else %>
              <span class="px-2.5 py-1 inline-flex text-xs font-semibold rounded-full bg-navy-950 text-navy-300 border border-navy-800">Final</span>
            <% end %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap">
            <% status_class = case dividend.status
               when 'paid' then 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/30'
               when 'cancelled' then 'bg-red-500/10 text-red-400 border border-red-500/30'
               else 'bg-amber-500/10 text-amber-400 border border-amber-500/30'
               end
            %>
            <span class="px-2.5 py-1 inline-flex text-xs font-semibold rounded-full <%= status_class %>">
              <%= dividend.status.titleize %>
            </span>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">
            <div><span class="font-medium text-gray-300">Qual:</span> <%= dividend.qualification_date&.strftime("%b %d, %Y") || "N/A" %></div>
            <div><span class="font-medium text-gray-300">Pay:</span> <%= dividend.payment_date&.strftime("%b %d, %Y") || "N/A" %></div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
            <div class="inline-flex items-center justify-end gap-1.5">
              <%= link_to admin_dividend_path(dividend), title: "View Dividend", class: "p-1.5 rounded-lg bg-gray-800 text-navy-400 hover:bg-navy-900/50 hover:text-navy-300 border border-gray-700 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              <% end %>
              <%= link_to edit_admin_dividend_path(dividend), title: "Edit Dividend", class: "p-1.5 rounded-lg bg-gray-800 text-amber-400 hover:bg-amber-900/30 hover:text-amber-300 border border-gray-700 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              <% end %>
              <%= button_to admin_dividend_path(dividend), method: :delete, title: "Delete Dividend", data: { turbo_confirm: "Are you sure you want to delete this dividend?" }, class: "p-1.5 rounded-lg bg-gray-800 text-red-400 hover:bg-red-900/30 hover:text-red-300 border border-gray-700 transition-colors cursor-pointer" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      
      <% if @dividends.empty? %>
        <tr>
          <td colspan="6" class="px-6 py-8 text-center text-gray-400">
            No dividends found. <%= link_to "Add one now", new_admin_dividend_path, class: "text-navy-600 hover:underline" %>.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
