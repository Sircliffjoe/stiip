<%= form_with(model: [:admin, dividend], local: true, class: "space-y-6") do |f| %>
  <% if dividend.errors.any? %>
    <div class="bg-red-50 p-4 rounded-md mb-6">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800"><%= pluralize(dividend.errors.count, "error") %> prohibited this dividend from being saved:</h3>
          <div class="mt-2 text-sm text-red-700">
            <ul class="list-disc pl-5 space-y-1">
              <% dividend.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <%= f.label :company_id, "Company", class: "block text-sm font-medium text-gray-300" %>
      <div class="mt-1">
        <%= f.collection_select :company_id, @companies, :id, :name, { prompt: "Select a Company" }, class: "shadow-sm focus:ring-navy-500 focus:border-navy-500 block w-full sm:text-sm border-gray-700 rounded-md bg-gray-800 text-white placeholder-gray-500" %>
      </div>
    </div>

    <div>
      <%= f.label :amount, "Amount", class: "block text-sm font-medium text-gray-300" %>
      <div class="mt-1 relative rounded-md shadow-sm">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <span class="text-gray-400 sm:text-sm">₦</span>
        </div>
        <%= f.number_field :amount, step: "0.01", class: "focus:ring-navy-500 focus:border-navy-500 block w-full pl-7 sm:text-sm border-gray-700 rounded-md bg-gray-800 text-white placeholder-gray-500" %>
      </div>
    </div>

    <div>
      <%= f.label :year, "Financial Year", class: "block text-sm font-medium text-gray-300" %>
      <div class="mt-1">
        <%= f.number_field :year, class: "shadow-sm focus:ring-navy-500 focus:border-navy-500 block w-full sm:text-sm border-gray-700 rounded-md bg-gray-800 text-white placeholder-gray-500" %>
      </div>
    </div>

    <div>
      <%= f.label :qualification_date, "Qualification Date (Ex-Dividend)", class: "block text-sm font-medium text-gray-300" %>
      <div class="mt-1">
        <%= f.date_field :qualification_date, class: "shadow-sm focus:ring-navy-500 focus:border-navy-500 block w-full sm:text-sm border-gray-700 rounded-md bg-gray-800 text-white placeholder-gray-500" %>
      </div>
    </div>

    <div>
      <%= f.label :payment_date, "Payment Date", class: "block text-sm font-medium text-gray-300" %>
      <div class="mt-1">
        <%= f.date_field :payment_date, class: "shadow-sm focus:ring-navy-500 focus:border-navy-500 block w-full sm:text-sm border-gray-700 rounded-md bg-gray-800 text-white placeholder-gray-500" %>
      </div>
    </div>

    <div>
      <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-300" %>
      <div class="mt-1">
        <%= f.select :status, Dividend.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "shadow-sm focus:ring-navy-500 focus:border-navy-500 block w-full sm:text-sm border-gray-700 rounded-md bg-gray-800 text-white placeholder-gray-500" %>
      </div>
    </div>

    <div class="flex items-center">
      <div class="flex items-start mt-6">
        <div class="h-5 flex items-center">
          <%= f.check_box :interim, class: "focus:ring-navy-500 h-4 w-4 text-navy-600 border-gray-700 rounded" %>
        </div>
        <div class="ml-3 text-sm">
          <%= f.label :interim, "Interim Dividend", class: "font-medium text-gray-300" %>
          <p class="text-gray-400">Is this an interim payment?</p>
        </div>
      </div>
    </div>
  </div>

  <div class="pt-5 flex justify-end border-t border-gray-800 mt-6 pt-6">
    <%= link_to "Cancel", admin_dividends_path, class: "bg-gray-900 border border-gray-800 py-2 px-4 border border-gray-700 rounded-md shadow-sm text-sm font-medium text-gray-300 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-navy-500 transition" %>
    <%= f.submit class: "ml-3 inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-navy-600 hover:bg-navy-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-navy-500 cursor-pointer transition" %>
  </div>
<% end %>
