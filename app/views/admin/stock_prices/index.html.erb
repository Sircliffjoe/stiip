<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-slate-900">Stock Prices (EOD)</h1>
  <%= form_tag import_admin_stock_prices_path, multipart: true, class: "flex items-center gap-2" do %>
    <%= file_field_tag :file, class: "text-sm text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
    <%= submit_tag "Upload CSV", class: "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 cursor-pointer" %>
  <% end %>
</div>
<div class="bg-white shadow overflow-hidden sm:rounded-lg border border-slate-200 p-8 text-center text-slate-500">
  Recent prices will render here.
</div>
