<div class="min-h-screen bg-gray-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-white">Subscriptions Management</h1>
        <p class="text-gray-400 mt-2">Manage all user subscriptions and plans</p>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      <div class="bg-gray-900 rounded-lg border border-gray-800 p-6 shadow-sm">
        <p class="text-sm font-medium text-gray-400">Active Subscriptions</p>
        <p class="text-3xl font-bold text-white mt-2"><%= @active_subscriptions %></p>
      </div>
      <div class="bg-gray-900 rounded-lg border border-gray-800 p-6 shadow-sm">
        <p class="text-sm font-medium text-gray-400">Expired Subscriptions</p>
        <p class="text-3xl font-bold text-white mt-2"><%= @expired_subscriptions %></p>
      </div>
      <div class="bg-gray-900 rounded-lg border border-gray-800 p-6 shadow-sm">
        <p class="text-sm font-medium text-gray-400">Total Subscriptions</p>
        <p class="text-3xl font-bold text-white mt-2"><%= Subscription.count %></p>
      </div>
    </div>

    <!-- Subscriptions Table -->
    <div class="bg-gray-900 rounded-lg border border-gray-800 overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead class="bg-gray-800 border-b border-gray-700">
            <tr>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-300">User</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-300">Plan</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-300">Status</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-300">Expires At</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-300">Reference</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-300">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800">
            <% @subscriptions.each do |subscription| %>
              <tr class="hover:bg-gray-800 transition-colors">
                <td class="px-6 py-4 text-sm">
                  <div>
                    <p class="font-medium text-white"><%= subscription.user.full_name %></p>
                    <p class="text-gray-400"><%= subscription.user.email %></p>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm">
                  <span class="px-3 py-1 rounded-full text-xs font-semibold bg-navy-900 text-navy-200">
                    <%= subscription.plan&.titleize || "—" %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm">
                  <% if subscription.active? %>
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-green-900 text-green-200">Active</span>
                  <% elsif subscription.expired? %>
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-red-900 text-red-200">Expired</span>
                  <% else %>
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-700 text-gray-300"><%= subscription.status&.titleize %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-300">
                  <%= subscription.expires_at.strftime("%b %d, %Y") if subscription.expires_at %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-400">
                  <span class="font-mono text-xs"><%= subscription.payment_reference&.truncate(20) || "—" %></span>
                </td>
                <td class="px-6 py-4 text-sm">
                  <div class="flex gap-2">
                    <%= link_to "View", admin_subscription_path(subscription), class: "text-navy-400 hover:text-navy-300 font-medium" %>
                    <%= link_to "Edit", edit_admin_subscription_path(subscription), class: "text-navy-400 hover:text-navy-300 font-medium" %>
                    <%= button_to "Cancel", admin_subscription_path(subscription), method: :delete, class: "text-red-400 hover:text-red-300 font-medium", form_class: "inline", form: { data: { turbo_confirm: "Are you sure?" } } %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <!-- Pagination -->
      <div class="px-6 py-4 border-t border-gray-800 flex items-center justify-between">
        <div class="text-sm text-gray-400">
          Page <%= @current_page %> of <%= @total_pages %>
        </div>
        <div class="flex gap-2">
          <% if @current_page > 1 %>
            <%= link_to "← Previous", admin_subscriptions_path(page: @current_page - 1), class: "px-3 py-2 border border-gray-700 text-gray-300 rounded-lg hover:bg-gray-800" %>
          <% end %>
          <% if @current_page < @total_pages %>
            <%= link_to "Next →", admin_subscriptions_path(page: @current_page + 1), class: "px-3 py-2 border border-gray-700 text-gray-300 rounded-lg hover:bg-gray-800" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
