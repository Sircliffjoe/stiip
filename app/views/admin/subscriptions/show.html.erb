<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="mb-8">
      <%= link_to "← Back to Subscriptions", admin_subscriptions_path, class: "text-navy-600 hover:text-navy-700 font-medium mb-4 inline-block" %>
      <h1 class="text-3xl font-bold text-gray-900">Subscription Details</h1>
    </div>

    <!-- Subscription Card -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
      <!-- User Info -->
      <div class="border-b border-gray-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">User Information</h2>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="text-sm text-gray-600">Name</p>
            <p class="font-medium text-gray-900"><%= @subscription.user.full_name %></p>
          </div>
          <div>
            <p class="text-sm text-gray-600">Email</p>
            <p class="font-medium text-gray-900"><%= @subscription.user.email %></p>
          </div>
          <div>
            <p class="text-sm text-gray-600">User Role</p>
            <p class="font-medium text-gray-900"><%= @subscription.user.role.titleize %></p>
          </div>
          <div>
            <p class="text-sm text-gray-600">Joined</p>
            <p class="font-medium text-gray-900"><%= @subscription.user.created_at.strftime("%b %d, %Y") %></p>
          </div>
        </div>
      </div>

      <!-- Subscription Info -->
      <div class="border-b border-gray-200 p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Subscription Information</h2>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="text-sm text-gray-600">Plan</p>
            <p class="font-medium text-gray-900"><%= @subscription.plan&.titleize %></p>
          </div>
          <div>
            <p class="text-sm text-gray-600">Status</p>
            <% if @subscription.active? %>
              <span class="px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-700 inline-block">Active</span>
            <% elsif @subscription.expired? %>
              <span class="px-3 py-1 rounded-full text-sm font-semibold bg-red-100 text-red-700 inline-block">Expired</span>
            <% else %>
              <span class="px-3 py-1 rounded-full text-sm font-semibold bg-gray-100 text-gray-700 inline-block"><%= @subscription.status&.titleize %></span>
            <% end %>
          </div>
          <div>
            <p class="text-sm text-gray-600">Expires At</p>
            <p class="font-medium text-gray-900"><%= @subscription.expires_at&.strftime("%b %d, %Y %H:%M") %></p>
          </div>
          <div>
            <p class="text-sm text-gray-600">Created At</p>
            <p class="font-medium text-gray-900"><%= @subscription.created_at.strftime("%b %d, %Y %H:%M") %></p>
          </div>
          <div class="col-span-2">
            <p class="text-sm text-gray-600">Payment Reference</p>
            <p class="font-mono text-sm text-gray-900 break-all"><%= @subscription.payment_reference || "—" %></p>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="p-6 flex gap-3">
        <%= link_to "Edit", edit_admin_subscription_path(@subscription), class: "px-4 py-2 bg-navy-600 text-white rounded-lg hover:bg-navy-700 font-medium" %>
        <%= link_to "Cancel Subscription", admin_subscription_path(@subscription), method: :delete, data: { confirm: "This will downgrade the user to free. Continue?" }, class: "px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 font-medium" %>
      </div>
    </div>
  </div>
</div>
