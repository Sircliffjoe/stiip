<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-white">Companies Directory</h1>
  <%= link_to "Add Company", new_admin_company_path, class: "bg-navy-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-navy-700 transition" %>
</div>

<div class="overflow-x-auto rounded-xl border border-gray-800 bg-gray-900 shadow">
  <table class="min-w-full divide-y divide-gray-800">
    <thead class="bg-gray-950">
      <tr>
        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Company</th>
        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Sector</th>
        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Price</th>
        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-400 uppercase tracking-wider">Market Cap</th>
        <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-400 uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-800 bg-gray-900">
      <% @companies.each do |company| %>
        <tr class="hover:bg-gray-800/50 transition-colors">
          <td class="px-6 py-4 whitespace-nowrap">
            <div class="flex items-center">
              <%= render "companies/logo", company: company, size_class: "h-10 w-10", text_class: "text-sm", rounded_class: "rounded-md" %>
              <div class="ml-4">
                <div class="text-sm font-medium text-white"><%= company.name %></div>
                <div class="text-sm text-gray-400"><%= company.ticker_symbol %></div>
              </div>
            </div>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">
            <%= company.sector&.name || "N/A" %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-white font-medium">
            <%= number_to_currency(company.latest_price, unit: "₦") || "N/A" %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">
            <%= number_to_human(company.market_cap, units: { billion: "B", million: "M" }, format: "%n%u") || "N/A" %>
          </td>
          <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
            <div class="inline-flex items-center justify-end gap-1.5">
              <%= link_to admin_company_path(company), title: "View Details", class: "p-1.5 rounded-lg bg-gray-800 text-navy-400 hover:bg-navy-900/50 hover:text-navy-300 border border-gray-700 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              <% end %>
              <%= link_to edit_admin_company_path(company), title: "Edit Company", class: "p-1.5 rounded-lg bg-gray-800 text-amber-400 hover:bg-amber-900/30 hover:text-amber-300 border border-gray-700 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              <% end %>
              <%= button_to admin_company_path(company), method: :delete, title: "Delete Company", data: { turbo_confirm: "Are you sure you want to delete #{company.name}?" }, class: "p-1.5 rounded-lg bg-gray-800 text-red-400 hover:bg-red-900/30 hover:text-red-300 border border-gray-700 transition-colors cursor-pointer" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      
      <% if @companies.empty? %>
        <tr>
          <td colspan="5" class="px-6 py-8 text-center text-gray-400">
            No companies found. <%= link_to "Add one now", new_admin_company_path, class: "text-navy-600 hover:underline" %>.
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
