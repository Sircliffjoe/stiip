<div class="max-w-5xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <div class="flex items-center gap-4">
      <div class="flex-shrink-0 h-12 w-12 flex items-center justify-center rounded-md bg-purple-900/50 text-purple-400 border border-purple-800 font-bold text-lg">
        <%= @company.ticker_symbol.first(2) %>
      </div>
      <div>
        <h1 class="text-2xl font-bold text-white"><%= @company.name %></h1>
        <p class="text-gray-400"><%= @company.ticker_symbol %> &bull; <%= @company.sector&.name %></p>
      </div>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_admin_company_path(@company), class: "bg-purple-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-purple-700 transition" %>
      <%= link_to "Back", admin_companies_path, class: "bg-gray-800 border border-gray-700 text-gray-300 px-4 py-2 rounded-md text-sm font-medium hover:bg-gray-700 transition" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="md:col-span-2 space-y-6">
      <div class="bg-gray-900 border border-gray-800 shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-white mb-4">About</h3>
        <p class="text-gray-400 text-sm whitespace-pre-wrap"><%= @company.description.presence || "No description provided." %></p>
      </div>

      <div class="bg-gray-900 border border-gray-800 shadow rounded-lg overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-800 flex justify-between items-center">
          <h3 class="text-lg font-medium text-white">Recent Dividends</h3>
          <%= link_to "View All", admin_dividends_path, class: "text-purple-400 hover:text-purple-300 text-sm" %>
        </div>
        <% if @company.dividends.any? %>
          <table class="min-w-full divide-y divide-gray-800">
            <thead class="bg-gray-800">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Amount</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Year</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Type</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-400 uppercase tracking-wider">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-800">
              <% @company.dividends.order(qualification_date: :desc).limit(5).each do |dividend| %>
                <tr>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-white"><%= number_to_currency(dividend.amount, unit: dividend.currency || "₦") %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400"><%= dividend.year %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400"><%= dividend.interim? ? "Interim" : "Final" %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400"><%= dividend.status.titleize %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% else %>
          <div class="p-6 text-center text-gray-400 text-sm">No dividends recorded.</div>
        <% end %>
      </div>
    </div>

    <div class="space-y-6">
      <div class="bg-gray-900 border border-gray-800 shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-white mb-4">Financial Metrics</h3>
        <dl class="space-y-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">Current Price</dt>
            <dd class="mt-1 text-2xl font-bold text-white"><%= number_to_currency(@company.latest_price, unit: "₦") || "N/A" %></dd>
          </div>
          <div class="pt-4 border-t border-gray-800">
            <dt class="text-sm font-medium text-gray-500">Market Cap</dt>
            <dd class="mt-1 text-lg font-semibold text-white"><%= number_to_human(@company.market_cap, units: { billion: "B", million: "M" }, format: "%n%u") || "N/A" %></dd>
          </div>
          <div class="pt-4 border-t border-gray-800">
            <dt class="text-sm font-medium text-gray-500">P/E Ratio</dt>
            <dd class="mt-1 text-lg font-semibold text-white"><%= @company.pe_ratio || "N/A" %></dd>
          </div>
          <div class="pt-4 border-t border-gray-800">
            <dt class="text-sm font-medium text-gray-500">Dividend Yield</dt>
            <dd class="mt-1 text-lg font-semibold text-white"><%= @company.dividend_yield.present? ? "#{@company.dividend_yield}%" : "N/A" %></dd>
          </div>
          <div class="pt-4 border-t border-gray-800">
            <dt class="text-sm font-medium text-gray-500">Shares Outstanding</dt>
            <dd class="mt-1 text-lg font-semibold text-white"><%= number_to_human(@company.shares_outstanding, units: { billion: "B", million: "M" }, format: "%n%u") || "N/A" %></dd>
          </div>
        </dl>
      </div>

      <div class="bg-gray-900 border border-gray-800 shadow rounded-lg p-6">
        <h3 class="text-lg font-medium text-white mb-4">Company Details</h3>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between">
            <dt class="text-gray-500">Founded</dt>
            <dd class="text-white font-medium"><%= @company.founded_year || "Unknown" %></dd>
          </div>
          <div class="flex justify-between">
            <dt class="text-gray-500">Status</dt>
            <dd class="text-white font-medium"><%= @company.listed ? "Listed" : "Delisted" %></dd>
          </div>
          <div class="flex flex-col pt-3 border-t border-gray-800">
            <dt class="text-gray-500 mb-1">Website</dt>
            <dd class="text-purple-400 truncate">
              <% if @company.website.present? && safe_external_url(@company.website) %>
                <%= link_to @company.website, safe_external_url(@company.website), target: "_blank", class: "hover:underline" %>
              <% else %>
                N/A
              <% end %>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</div>
