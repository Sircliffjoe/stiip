<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-white">Education CMS</h1>
      <p class="mt-1 text-sm text-gray-400">Create investing lessons and guides.</p>
    </div>
    <%= link_to "New Lesson", new_admin_educational_content_path, class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-500" %>
  </div>

  <div class="overflow-hidden rounded-lg border border-gray-800 bg-gray-900">
    <% if @contents.any? %>
      <table class="min-w-full divide-y divide-gray-800">
        <thead class="bg-gray-950/60">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-400">Title</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-400">Category</th>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-400">Level</th>
            <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-400">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
          <% @contents.each do |content| %>
            <tr>
              <td class="px-4 py-4 font-medium text-white"><%= content.title %></td>
              <td class="px-4 py-4 text-sm text-gray-300"><%= content.category %></td>
              <td class="px-4 py-4 text-sm text-gray-300"><%= content.difficulty_level.humanize %></td>
              <td class="px-4 py-4 text-right text-sm">
                <%= link_to "View", admin_educational_content_path(content), class: "font-medium text-emerald-300 hover:text-emerald-200" %>
                <%= link_to "Edit", edit_admin_educational_content_path(content), class: "ml-3 font-medium text-gray-300 hover:text-white" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="p-10 text-center text-gray-400">No educational content yet.</div>
    <% end %>
  </div>
</div>
