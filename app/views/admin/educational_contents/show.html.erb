<div class="mx-auto max-w-3xl space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <%= link_to "Education CMS", admin_educational_contents_path, class: "text-sm font-medium text-navy-300 hover:text-navy-200" %>
      <h1 class="mt-2 text-2xl font-bold text-white"><%= @content.title %></h1>
      <p class="mt-2 text-sm text-gray-400"><%= @content.category %> · <%= @content.difficulty_level.humanize %></p>
    </div>
    <%= link_to "Edit", edit_admin_educational_content_path(@content), class: "rounded-lg bg-navy-600 px-4 py-2 text-sm font-semibold text-white hover:bg-navy-500" %>
  </div>

  <div class="rounded-lg border border-gray-800 bg-gray-900 p-6">
    <h3 class="text-sm font-semibold text-gray-300 mb-2">Summary</h3>
    <p class="leading-7 text-gray-300"><%= @content.summary %></p>
  </div>

  <% if @content.excerpt.present? %>
    <div class="rounded-lg border border-navy-800 bg-navy-950/50 p-6">
      <h3 class="text-sm font-semibold text-navy-300 mb-2">Excerpt</h3>
      <p class="italic text-navy-200"><%= @content.excerpt %></p>
    </div>
  <% end %>

  <% if @content.body.present? %>
    <div class="rounded-lg border border-gray-800 bg-gray-900 p-6">
      <h3 class="text-sm font-semibold text-gray-300 mb-4">Body</h3>
      <div class="max-w-none space-y-4 text-sm leading-6 text-gray-300">
        <%= simple_format(@content.body) %>
      </div>
    </div>
  <% end %>

  <div class="rounded-lg border border-gray-800 bg-gray-900 p-6">
    <h3 class="text-sm font-semibold text-gray-300 mb-2">Publishing</h3>
    <dl class="space-y-2 text-sm">
      <div>
        <dt class="text-gray-500">Published At</dt>
        <dd class="text-gray-300"><%= @content.published_at&.strftime("%B %d, %Y at %I:%M %p") || "Not published" %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Featured</dt>
        <dd class="text-gray-300"><%= @content.featured? ? "Yes" : "No" %></dd>
      </div>
      <div>
        <dt class="text-gray-500">Author</dt>
        <dd class="text-gray-300"><%= @content.author&.email || "Unknown" %></dd>
      </div>
    </dl>
  </div>

  <%= button_to "Delete Lesson", admin_educational_content_path(@content), method: :delete, class: "rounded-lg border border-red-500/30 px-4 py-2 text-sm font-semibold text-red-300 hover:bg-red-500/10", form: { data: { turbo_confirm: "Delete this lesson?" } } %>
</div>
