<%= form_with model: [:admin, user], class: "space-y-6 rounded-xl border border-gray-800 bg-gray-900 p-6" do |f| %>
  <% if user.errors.any? %>
    <div class="rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-200">
      <%= user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= f.label :first_name, class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.text_field :first_name, required: true, class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-3.5 py-2.5 text-sm text-white focus:border-navy-500 focus:ring-navy-500" %>
    </div>
    <div>
      <%= f.label :last_name, class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.text_field :last_name, required: true, class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-3.5 py-2.5 text-sm text-white focus:border-navy-500 focus:ring-navy-500" %>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.email_field :email, required: true, class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-3.5 py-2.5 text-sm text-white focus:border-navy-500 focus:ring-navy-500" %>
    </div>
    <div>
      <%= f.label :phone, class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.text_field :phone, placeholder: "+234...", class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-3.5 py-2.5 text-sm text-white focus:border-navy-500 focus:ring-navy-500" %>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= f.label :role, class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.select :role, User.roles.keys.map { |r| [r.humanize, r] }, { selected: user.role || "free" }, class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-3.5 py-2.5 text-sm text-white focus:border-navy-500 focus:ring-navy-500" %>
    </div>
    <div>
      <%= f.label :subscription_plan, "Subscription Plan", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.select :subscription_plan, [["Free", "free"], ["Premium", "premium"], ["Business / API", "business_api"]], { selected: user.subscription&.plan || "free" }, class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-3.5 py-2.5 text-sm text-white focus:border-navy-500 focus:ring-navy-500" %>
    </div>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    <div>
      <%= f.label :password, user.persisted? ? "Password (leave blank to keep unchanged)" : "Password", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.password_field :password, required: !user.persisted?, class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-3.5 py-2.5 text-sm text-white focus:border-navy-500 focus:ring-navy-500" %>
    </div>
    <div>
      <%= f.label :password_confirmation, "Confirm Password", class: "block text-sm font-medium text-gray-300 mb-1" %>
      <%= f.password_field :password_confirmation, required: !user.persisted?, class: "w-full rounded-lg border border-gray-700 bg-gray-950 px-3.5 py-2.5 text-sm text-white focus:border-navy-500 focus:ring-navy-500" %>
    </div>
  </div>

  <div class="pt-2">
    <label class="flex items-center gap-3 cursor-pointer">
      <%= f.check_box :confirm_user, { checked: user.confirmed_at.present?, class: "h-4 w-4 rounded border-gray-700 bg-gray-950 text-navy-600 focus:ring-navy-500" }, "1", "0" %>
      <span class="text-sm font-medium text-gray-300">Mark email as confirmed (bypass email verification)</span>
    </label>
  </div>

  <div class="flex items-center gap-3 pt-4 border-t border-gray-800">
    <%= f.submit user.persisted? ? "Update User" : "Create User", class: "rounded-lg bg-navy-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-navy-500 shadow-sm cursor-pointer" %>
    <%= link_to "Cancel", admin_users_path, class: "rounded-lg border border-gray-700 px-5 py-2.5 text-sm font-semibold text-gray-300 hover:bg-gray-800" %>
  </div>
<% end %>
