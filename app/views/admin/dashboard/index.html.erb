<h1 class="text-2xl font-bold text-white mb-6">Admin Dashboard</h1>
<div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
  <div class="bg-gray-900 overflow-hidden shadow rounded-lg border border-gray-800">
    <div class="px-4 py-5 sm:p-6">
      <dt class="text-sm font-medium text-gray-400 truncate">Total Users</dt>
      <dd class="mt-1 text-3xl font-semibold text-white"><%= @users_count %></dd>
    </div>
  </div>
  <div class="bg-gray-900 overflow-hidden shadow rounded-lg border border-gray-800">
    <div class="px-4 py-5 sm:p-6">
      <dt class="text-sm font-medium text-gray-400 truncate">Premium Subscribers</dt>
      <dd class="mt-1 text-3xl font-semibold text-white"><%= @premium_users %></dd>
    </div>
  </div>
  <div class="bg-gray-900 overflow-hidden shadow rounded-lg border border-gray-800">
    <div class="px-4 py-5 sm:p-6">
      <dt class="text-sm font-medium text-gray-400 truncate">Active Subscriptions</dt>
      <dd class="mt-1 text-3xl font-semibold text-white"><%= Subscription.where(status: :active).count %></dd>
    </div>
  </div>
  <div class="bg-gray-900 overflow-hidden shadow rounded-lg border border-gray-800">
    <div class="px-4 py-5 sm:p-6">
      <dt class="text-sm font-medium text-gray-400 truncate">Listed Companies</dt>
      <dd class="mt-1 text-3xl font-semibold text-white"><%= @companies_count %></dd>
    </div>
  </div>
  <div class="bg-gray-900 overflow-hidden shadow rounded-lg border border-gray-800">
    <div class="px-4 py-5 sm:p-6">
      <dt class="text-sm font-medium text-gray-400 truncate">News Articles</dt>
      <dd class="mt-1 text-3xl font-semibold text-white"><%= @news_count %></dd>
    </div>
  </div>
  <div class="bg-gray-900 overflow-hidden shadow rounded-lg border border-gray-800">
    <div class="px-4 py-5 sm:p-6">
      <dt class="text-sm font-medium text-gray-400 truncate">Learning Modules</dt>
      <dd class="mt-1 text-3xl font-semibold text-white"><%= @education_count %></dd>
    </div>
  </div>
  <div class="bg-gray-900 overflow-hidden shadow rounded-lg border border-gray-800">
    <div class="px-4 py-5 sm:p-6">
      <dt class="text-sm font-medium text-gray-400 truncate">Unread Notifications</dt>
      <dd class="mt-1 text-3xl font-semibold text-white"><%= @unread_notifications %></dd>
    </div>
  </div>
</div>

<!-- Quick Links -->
<div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
  <%= link_to admin_users_path, class: "bg-navy-600 hover:bg-navy-700 text-white p-6 rounded-lg shadow transition-colors" do %>
    <p class="text-sm font-medium text-navy-100">Manage Users</p>
    <p class="text-2xl font-bold mt-2">Users</p>
  <% end %>
  
  <%= link_to admin_subscriptions_path, class: "bg-navy-600 hover:bg-navy-700 text-white p-6 rounded-lg shadow transition-colors" do %>
    <p class="text-sm font-medium text-navy-100">Manage Subscriptions</p>
    <p class="text-2xl font-bold mt-2">Subscriptions</p>
  <% end %>
  
  <%= link_to admin_companies_path, class: "bg-green-600 hover:bg-green-700 text-white p-6 rounded-lg shadow transition-colors" do %>
    <p class="text-sm font-medium text-green-100">Manage Companies</p>
    <p class="text-2xl font-bold mt-2">Companies</p>
  <% end %>
  
  <%= link_to admin_news_articles_path, class: "bg-navy-700 hover:bg-navy-800 text-white p-6 rounded-lg shadow transition-colors" do %>
    <p class="text-sm font-medium text-gold-100">Manage News</p>
    <p class="text-2xl font-bold mt-2">Articles</p>
  <% end %>
