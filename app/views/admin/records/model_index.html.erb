<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <%= link_to "Records Console", admin_records_path, class: "text-sm text-navy-300 hover:text-navy-200" %>
      <h1 class="mt-2 text-2xl font-bold text-white"><%= @model_class.model_name.human(count: 2) %></h1>
      <p class="mt-1 text-sm text-gray-400">Showing up to 100 most recent records.</p>
    </div>
    <%= link_to "New #{model_label}", admin_new_record_path(model: model_param), class: "rounded-lg bg-navy-600 px-4 py-2 text-sm font-semibold text-white hover:bg-navy-700" %>
  </div>

  <div class="overflow-x-auto rounded-lg border border-gray-800 bg-gray-900">
    <table class="min-w-full divide-y divide-gray-800">
      <thead class="bg-gray-950">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-400">ID</th>
          <% @model_class.column_names.first(5).each do |column| %>
            <% next if column == "id" %>
            <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-gray-400"><%= column.humanize %></th>
          <% end %>
          <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-gray-400">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-800">
        <% @records.each do |record| %>
          <tr>
            <td class="max-w-xs truncate px-4 py-3 text-xs font-mono text-gray-300"><%= record.id %></td>
            <% @model_class.column_names.first(5).each do |column| %>
              <% next if column == "id" %>
              <td class="max-w-xs truncate px-4 py-3 text-sm text-gray-300"><%= display_value(record, column) %></td>
            <% end %>
            <td class="whitespace-nowrap px-4 py-3 text-right text-sm">
              <div class="inline-flex items-center justify-end gap-1.5">
                <%= link_to admin_record_path(model: model_param, id: record.id), title: "View Record", class: "p-1.5 rounded-lg bg-gray-800 text-navy-400 hover:bg-navy-900/50 hover:text-navy-300 border border-gray-700 transition-colors" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <% end %>
                <%= link_to admin_edit_record_path(model: model_param, id: record.id), title: "Edit Record", class: "p-1.5 rounded-lg bg-gray-800 text-amber-400 hover:bg-amber-900/30 hover:text-amber-300 border border-gray-700 transition-colors" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                <% end %>
                <%= button_to admin_record_path(model: model_param, id: record.id), method: :delete, title: "Delete Record", data: { turbo_confirm: "Delete this #{model_label}?" }, class: "p-1.5 rounded-lg bg-gray-800 text-red-400 hover:bg-red-900/30 hover:text-red-300 border border-gray-700 transition-colors cursor-pointer" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
