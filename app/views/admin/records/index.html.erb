<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-white">Records Console</h1>
    <p class="mt-1 text-sm text-gray-400">Super-admin CRUD access across every application model.</p>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @model_names.each do |model_name| %>
      <% model_class = model_name.constantize %>
      <%= link_to admin_records_model_path(model: model_class.model_name.singular), class: "rounded-lg border border-gray-800 bg-gray-900 p-5 hover:border-navy-500 hover:bg-gray-800 transition-colors" do %>
        <p class="text-lg font-semibold text-white"><%= model_class.model_name.human(count: 2) %></p>
        <p class="mt-2 text-sm text-gray-400"><%= pluralize(model_class.count, "record") %></p>
      <% end %>
    <% end %>
  </div>
</div>
