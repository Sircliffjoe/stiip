<div class="container mx-auto px-4 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-white">Data Imports</h1>
    <p class="text-gray-400 mt-2">Manage stock data, dividends, and news imports</p>
  </div>

  <!-- Success/Error Messages -->
  <% if notice.present? %>
    <%= render "components/alert/alert", type: "success", message: notice %>
  <% end %>
  <% if alert.present? %>
    <%= render "components/alert/alert", type: "error", message: alert %>
  <% end %>

  <!-- Import Actions -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <!-- Sync Stock Prices -->
    <div class="bg-gray-900 border border-gray-800 rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Stock Prices</h3>
      <p class="text-sm text-gray-400 mb-4">Sync stock prices for today</p>
      <%= form_with url: sync_prices_admin_data_imports_path, method: :post, local: true do |f| %>
        <div class="flex gap-2 mb-3">
          <%= f.select :provider, [["Market Composite", "market"], ["NGN Market", "ngn_market"], ["NGX Pulse", "ngx"], ["CSV", "csv"]], { selected: "market" }, class: "flex-1 px-3 py-2 border border-gray-700 rounded-md text-sm bg-gray-800 text-white" %>
        </div>
        <%= f.submit "Sync Prices", class: "w-full bg-navy-600 text-white px-4 py-2 rounded-md hover:bg-navy-700 transition" %>
      <% end %>
    </div>

    <!-- Sync Dividends -->
    <div class="bg-gray-900 border border-gray-800 rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Dividends</h3>
      <p class="text-sm text-gray-400 mb-4">Sync dividend announcements</p>
      <%= form_with url: sync_dividends_admin_data_imports_path, method: :post, local: true do |f| %>
        <div class="flex gap-2 mb-3">
          <%= f.select :provider, [["EODHD", "eodhd"], ["Market Composite", "market"], ["NGX Pulse", "ngx"], ["CSV", "csv"]], { selected: "eodhd" }, class: "flex-1 px-3 py-2 border border-gray-700 rounded-md text-sm bg-gray-800 text-white" %>
        </div>
        <%= f.submit "Sync Dividends", class: "w-full bg-navy-600 text-white px-4 py-2 rounded-md hover:bg-navy-700 transition" %>
      <% end %>
    </div>

    <!-- Sync News -->
    <div class="bg-gray-900 border border-gray-800 rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-white mb-4">Market News</h3>
      <p class="text-sm text-gray-400 mb-4">Sync latest market news</p>
      <%= form_with url: sync_news_admin_data_imports_path, method: :post, local: true do |f| %>
        <div class="flex gap-2 mb-3">
          <%= f.select :provider, [["Market Composite", "market"], ["NGN Market", "ngn_market"], ["NGX Pulse", "ngx"]], { selected: "market" }, class: "flex-1 px-3 py-2 border border-gray-700 rounded-md text-sm bg-gray-800 text-white" %>
        </div>
        <%= f.submit "Sync News", class: "w-full bg-navy-600 text-white px-4 py-2 rounded-md hover:bg-navy-700 transition" %>
      <% end %>
    </div>
  </div>

  <!-- CSV Import -->
  <div class="bg-gray-900 border border-gray-800 rounded-lg shadow p-6 mb-8">
    <h3 class="text-lg font-semibold text-white mb-4">Bulk Import (CSV)</h3>
    <p class="text-sm text-gray-400 mb-4">Upload a CSV file with stock price data</p>
    <%= form_with url: import_csv_admin_data_imports_path, method: :post, local: true, multipart: true do |f| %>
      <div class="flex gap-3 items-end">
        <div class="flex-1">
          <%= f.file_field :csv_file, accept: ".csv", class: "block w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-navy-900/30 file:text-navy-700 hover:file:bg-navy-900/50" %>
          <p class="text-xs text-gray-400 mt-1">Expected format: ticker_symbol,date,open,high,low,close,volume</p>
        </div>
        <%= f.submit "Import CSV", class: "bg-navy-600 text-white px-6 py-2 rounded-md hover:bg-navy-700 transition whitespace-nowrap" %>
      </div>
    <% end %>
  </div>

  <!-- Import History -->
  <div class="bg-gray-900 border border-gray-800 rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-800">
      <h3 class="text-lg font-semibold text-white">Recent Imports</h3>
    </div>
    
    <% if @recent_imports.any? %>
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-800 border-b border-gray-800">
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Type</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Provider</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Records</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">User</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-300 uppercase tracking-wider">Date</th>
            </tr>
          </thead>
          <tbody class="bg-gray-900 border border-gray-800 divide-y divide-gray-800">
            <% @recent_imports.each do |log| %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-white">
                  <%= log.data_type %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">
                  <span class="px-2 py-1 bg-gray-800 text-gray-300 border border-gray-700 rounded text-xs font-medium">
                    <%= log.provider %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if log.success? %>
                    <span class="px-2 py-1 bg-green-900/30 text-green-400 border border-green-800 rounded text-xs font-medium">✅ Success</span>
                  <% else %>
                    <span class="px-2 py-1 bg-red-900/30 text-red-400 border border-red-800 rounded text-xs font-medium">❌ Failed</span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">
                  <%= log.records_imported %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">
                  <%= log.imported_by&.email || "System" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-400">
                  <%= time_ago_in_words(log.created_at) %> ago
                </td>
              </tr>
              <% if log.error_message.present? %>
                <tr class="bg-red-900/30">
                  <td colspan="6" class="px-6 py-3 text-sm text-red-400">
                    <strong>Error:</strong> <%= log.error_message %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-6 py-8 text-center">
        <p class="text-gray-400">No imports yet. Start by syncing data above!</p>
      </div>
    <% end %>
  </div>

  <!-- Statistics -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
    <div class="bg-gray-900 border border-gray-800 rounded-lg shadow p-6">
      <p class="text-gray-400 text-sm mb-2">Total Imports</p>
      <p class="text-3xl font-bold text-white"><%= DataImportLog.count %></p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg shadow p-6">
      <p class="text-gray-400 text-sm mb-2">Success Rate (30 days)</p>
      <p class="text-3xl font-bold text-green-600"><%= DataImportLog.success_rate %> %</p>
    </div>
    <div class="bg-gray-900 border border-gray-800 rounded-lg shadow p-6">
      <p class="text-gray-400 text-sm mb-2">Records Imported (30 days)</p>
      <p class="text-3xl font-bold text-navy-600"><%= DataImportLog.where("created_at > ?", 30.days.ago).sum(:records_imported) %></p>
    </div>
  </div>
</div>

<style>
  pre {
    background: rgba(0, 31, 63, 0.5);
    padding: 8px;
    border-radius: 4px;
  }
</style>
