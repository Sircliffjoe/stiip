<% content_for(:title, "Search — NoraCapital") %>

<div class="space-y-8">
  <div>
    <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Search</h1>
    <p class="mt-2 text-gray-600 font-light">Find companies, news, and educational content across the platform.</p>
  </div>

  <!-- Search Form -->
  <div class="relative">
    <%= form_with url: search_path, method: :get, local: true, class: "flex gap-3" do %>
      <div class="flex-1 relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <%= text_field_tag :query, @query, placeholder: "Search companies, news, articles...", class: "w-full pl-12 pr-4 py-3.5 bg-white border border-gray-300 rounded-xl text-gray-900 placeholder-gray-400 focus:ring-2 focus:ring-navy-500 focus:border-transparent transition", autofocus: true %>
      </div>
      <%= submit_tag "Search", class: "px-8 py-3.5 bg-navy-700 text-white font-semibold rounded-xl shadow-lg hover:-translate-y-0.5 hover:shadow-xl transition-all duration-300 cursor-pointer" %>
    <% end %>
  </div>

  <% if @query.present? %>
    <% if @login_required %>
      <%= render "shared/locked_feature",
        title: "Log in to search NoraCapital",
        message: "You must be logged in to access company, news, and educational search results.",
        cta_label: "Log in",
        cta_path: new_user_session_path,
        secondary_label: "Create free account",
        secondary_path: new_user_registration_path %>
    <% else %>
    <!-- Results Summary -->
    <div class="flex items-center gap-2 text-sm text-gray-500">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      Found <strong class="text-gray-900"><%= @total_count %></strong> results for "<%= @query %>"
    </div>

    <% if @total_count == 0 %>
      <div class="text-center py-16 bg-white border border-gray-200 rounded-2xl">
        <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <p class="text-gray-500 text-lg">No results found for "<strong><%= @query %></strong>"</p>
        <p class="text-gray-400 text-sm mt-2">Try searching with different keywords.</p>
      </div>
    <% end %>

    <!-- Companies Results -->
    <% if @companies.any? %>
      <div>
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-navy-600"></span>
          Companies <span class="text-sm font-normal text-gray-500">(<%= @companies.length %>)</span>
        </h2>
        <div class="space-y-3">
          <% @companies.each do |company| %>
            <%= link_to company_path(company.ticker_symbol), class: "block bg-white border border-gray-200 rounded-xl p-5 hover:border-navy-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 group" do %>
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-navy-700 flex items-center justify-center text-white font-bold shrink-0">
                  <%= company.ticker_symbol.first(2) %>
                </div>
                <div class="flex-1">
                  <div class="font-semibold text-gray-900 group-hover:text-navy-700 transition-colors"><%= company.name %></div>
                  <div class="text-sm text-gray-500"><%= company.ticker_symbol %> · <%= company.sector&.name %></div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-gray-900"><%= number_to_currency(company.latest_price, unit: "₦") %></div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- News Results -->
    <% if @news.any? %>
      <div>
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-navy-500"></span>
          News <span class="text-sm font-normal text-gray-500">(<%= @news.length %>)</span>
        </h2>
        <div class="space-y-3">
          <% @news.each do |article| %>
            <%= link_to news_article_path(article.slug), class: "block bg-white border border-gray-200 rounded-xl p-5 hover:border-navy-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 group" do %>
              <div class="font-semibold text-gray-900 group-hover:text-navy-700 transition-colors mb-1"><%= article.title %></div>
              <p class="text-sm text-gray-500 line-clamp-2"><%= article.summary %></p>
              <div class="mt-2 text-xs text-gray-400"><%= article.published_at&.strftime("%b %d, %Y") %> · <%= article.category %></div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Educational Content Results -->
    <% if @educational.any? %>
      <div>
        <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-navy-500"></span>
          Learn <span class="text-sm font-normal text-gray-500">(<%= @educational.length %>)</span>
        </h2>
        <div class="space-y-3">
          <% @educational.each do |content| %>
            <%= link_to educational_content_path(content.slug), class: "block bg-white border border-gray-200 rounded-xl p-5 hover:border-navy-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 group" do %>
              <div class="flex items-center gap-3 mb-1">
                <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-navy-100 text-navy-700"><%= content.difficulty_level&.titleize || "Beginner" %></span>
                <span class="text-xs text-gray-400"><%= content.category %></span>
              </div>
              <div class="font-semibold text-gray-900 group-hover:text-navy-700 transition-colors"><%= content.title %></div>
              <p class="text-sm text-gray-500 line-clamp-2 mt-1"><%= content.excerpt %></p>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <% end %>
  <% end %>
</div>
