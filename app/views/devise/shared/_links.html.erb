<div class="mt-6 flex flex-col space-y-3 text-sm text-center">
  <%- if controller_name != 'sessions' %>
    <%= link_to "Log in to your account", new_session_path(resource_name), class: "font-medium text-blue-400 hover:text-blue-300 transition-colors" %><br />
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "Create an account", new_registration_path(resource_name), class: "font-medium text-emerald-400 hover:text-emerald-300 transition-colors" %><br />
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Forgot your password?", new_password_path(resource_name), class: "font-medium text-gray-400 hover:text-gray-300 transition-colors" %><br />
  <% end %>
</div>
