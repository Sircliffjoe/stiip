<% company = dividend.company %>
<%= link_to company_path(company.ticker_symbol), class: "flex flex-col items-start justify-between gap-4 rounded-xl border border-gray-200 bg-gray-50 p-4 shadow-sm transition hover:border-navy-300 hover:shadow-md sm:flex-row sm:items-center" do %>
  <div class="flex items-center gap-4">
    <div class="flex h-12 w-12 items-center justify-center rounded-full bg-navy-700 text-sm font-bold text-white">
      <%= company.ticker_symbol.first(2) %>
    </div>
    <div>
      <p class="text-lg font-bold text-gray-900"><%= company.ticker_symbol %></p>
      <p class="text-sm text-gray-600"><%= company.name %></p>
    </div>
  </div>

  <div class="grid w-full grid-cols-1 gap-4 sm:w-auto sm:grid-cols-3 sm:gap-10">
    <div>
      <p class="text-xs font-semibold uppercase text-gray-500">Amount</p>
      <p class="text-lg font-bold text-gray-900"><%= number_to_currency(dividend.amount, unit: "₦") %> <span class="text-xs font-normal text-gray-600">/ share</span></p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase text-gray-500">Qualifies By</p>
      <p class="font-medium text-gray-900"><%= dividend.qualification_date&.strftime("%b %d, %Y") || "Not stated" %></p>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase text-gray-500"><%= date_label %></p>
      <p class="font-bold text-navy-700"><%= dividend.payment_date&.strftime("%b %d, %Y") || "Not stated" %></p>
    </div>
  </div>
<% end %>
