<div class="space-y-6">
  <div>
    <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Dividend Intelligence</h1>
    <p class="mt-2 text-gray-600 font-light max-w-3xl">Review historical payouts, spot consistent dividend companies, and track future announced payments when they become available.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden p-6">
    <% if @login_required %>
      <%= render "shared/locked_feature",
        title: "Log in to view dividend details",
        message: "You must be logged in to access dividend amounts, qualification dates, payment dates, and dividend history.",
        cta_label: "Log in",
        cta_path: new_user_session_path,
        secondary_label: "Create free account",
        secondary_path: new_user_registration_path %>
    <% else %>
      <% if @premium_required %>
        <div class="mb-6">
          <%= render "shared/locked_feature",
            title: "Upgrade for dividend analytics",
            message: "Free users can view a limited dividend history. Premium unlocks dividend yield analysis, growth rankings, and consistency signals.",
            cta_label: "Upgrade to Premium",
            cta_path: pricing_path,
            secondary_label: nil %>
        </div>
      <% elsif @dividend_analytics.present? %>
        <div class="mb-8 grid grid-cols-1 gap-4 md:grid-cols-4">
          <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase text-gray-500">Companies</p>
            <p class="mt-2 text-2xl font-black text-gray-900"><%= number_with_delimiter(@dividend_analytics[:companies_count]) %></p>
          </div>
          <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase text-gray-500">Dividend Records</p>
            <p class="mt-2 text-2xl font-black text-gray-900"><%= number_with_delimiter(@dividend_analytics[:records_count]) %></p>
          </div>
          <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase text-gray-500">Recorded Payouts</p>
            <p class="mt-2 text-2xl font-black text-gray-900"><%= number_to_currency(@dividend_analytics[:total_declared], unit: "₦") %></p>
          </div>
          <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
            <p class="text-xs font-semibold uppercase text-gray-500">Avg Latest Yield</p>
            <p class="mt-2 text-2xl font-black text-gray-900"><%= @dividend_analytics[:average_yield].present? ? "#{@dividend_analytics[:average_yield]}%" : "N/A" %></p>
          </div>
        </div>

        <div class="mb-8 grid grid-cols-1 gap-4 lg:grid-cols-3">
          <%= render "dividend_analysis_panel", title: "Highest Latest Yield", rows: @dividend_analytics[:top_yields], value_key: :latest_yield_percent, value_suffix: "%" %>
          <%= render "dividend_analysis_panel", title: "Strongest Payout Growth", rows: @dividend_analytics[:strongest_growth], value_key: :growth_percent, value_suffix: "%" %>
          <%= render "dividend_analysis_panel", title: "Most Consistent Payers", rows: @dividend_analytics[:most_consistent], value_key: :years_paid, value_suffix: " yrs" %>
        </div>
      <% end %>

      <%= turbo_frame_tag "dividends_content" do %>
        <%= render "dividend_tabs" %>
      <% end %>
    <% end %>
  </div>
</div>
