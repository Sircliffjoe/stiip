<div class="space-y-6">
  <div>
    <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Dividend Calendar</h1>
    <p class="mt-2 text-gray-600 font-light max-w-2xl">Track upcoming dividend payments, qualification dates, and historical yields to maximize your passive income.</p>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden p-6">
    <h2 class="text-xl font-bold text-gray-900 mb-6">Upcoming Dividends</h2>
    
    <% if @dividends.any? %>
      <div class="space-y-4">
        <% @dividends.each do |dividend| %>
          <% company = dividend.company %>
          <%= link_to company_path(company.ticker_symbol), class: "flex flex-col sm:flex-row items-center justify-between p-4 bg-gray-50 rounded-xl border border-gray-200 shadow-sm hover:shadow-md hover:border-navy-300 transition-all" do %>
            <div class="flex items-center gap-4 w-full sm:w-auto mb-4 sm:mb-0">
              <div class="w-12 h-12 rounded-full bg-navy-700 flex items-center justify-center text-white font-bold text-sm">
                <%= company.ticker_symbol.first(2) %>
              </div>
              <div>
                <p class="font-bold text-gray-900 text-lg"><%= company.ticker_symbol %></p>
                <p class="text-sm text-gray-600"><%= company.name %></p>
              </div>
            </div>
            
            <div class="flex flex-col sm:flex-row gap-6 sm:gap-12 w-full sm:w-auto items-start sm:items-center">
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase">Amount</p>
                <p class="font-bold text-gray-900 text-lg"><%= number_to_currency(dividend.amount, unit: "₦") %> <span class="text-xs font-normal text-gray-600">/ share</span></p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase">Qualifies By</p>
                <p class="font-medium text-gray-900"><%= dividend.qualification_date&.strftime("%b %d, %Y") %></p>
              </div>
              <div>
                <p class="text-xs font-semibold text-gray-500 uppercase">Payment Date</p>
                <p class="font-bold text-navy-600"><%= dividend.payment_date&.strftime("%b %d, %Y") %></p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-gray-300 bg-gray-50 p-6 text-center text-sm text-gray-500">
        No verified dividend feed is connected yet. Dividend records will appear here once imported from a licensed dividend/corporate-actions source.
      </div>
    <% end %>
  </div>
</div>
