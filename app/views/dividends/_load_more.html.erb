<% if current_limit < total_count %>
  <div class="mt-6 flex justify-center">
    <%= link_to dividends_path(
        tab: tab,
        historical_limit: historical_limit,
        upcoming_limit: upcoming_limit
      ),
      data: { turbo_frame: "dividends_content" },
      class: "inline-flex items-center justify-center rounded-lg border border-navy-200 bg-white px-5 py-3 text-sm font-bold text-navy-700 shadow-sm transition hover:border-navy-400 hover:bg-navy-50" do %>
      Load more
      <span class="ml-2 text-xs font-semibold text-gray-500">
        <%= number_with_delimiter([current_limit, total_count].min) %> of <%= number_with_delimiter(total_count) %>
      </span>
    <% end %>
  </div>
<% end %>
