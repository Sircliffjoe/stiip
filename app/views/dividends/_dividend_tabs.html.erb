<div>
  <div class="mb-6 flex flex-wrap gap-2 border-b border-gray-200">
    <%= link_to dividends_path(tab: "historical", historical_limit: @historical_limit, upcoming_limit: @upcoming_limit),
      data: { turbo_frame: "dividends_content" },
      class: [
        "border-b-2 px-4 py-3 text-sm font-bold transition",
        @selected_tab == "historical" ? "border-navy-700 text-navy-700" : "border-transparent text-gray-500 hover:text-navy-700"
      ].join(" ") do %>
      Historical Dividends
      <span class="ml-1 text-xs font-semibold text-gray-400">(<%= number_with_delimiter(@historical_total_count) %>)</span>
    <% end %>

    <%= link_to dividends_path(tab: "upcoming", historical_limit: @historical_limit, upcoming_limit: @upcoming_limit),
      data: { turbo_frame: "dividends_content" },
      class: [
        "border-b-2 px-4 py-3 text-sm font-bold transition",
        @selected_tab == "upcoming" ? "border-navy-700 text-navy-700" : "border-transparent text-gray-500 hover:text-navy-700"
      ].join(" ") do %>
      Upcoming Dividends
      <span class="ml-1 text-xs font-semibold text-gray-400">(<%= number_with_delimiter(@upcoming_total_count) %>)</span>
    <% end %>
  </div>

  <% if @selected_tab == "upcoming" %>
    <div class="mb-4">
      <h2 class="text-xl font-bold text-gray-900">Upcoming Dividends</h2>
      <p class="mt-1 text-sm text-gray-500">Future announced qualification and payment dates will appear here when available from API feeds or admin entry.</p>
    </div>

    <% if @upcoming_dividends.any? %>
      <div class="space-y-4">
        <% @upcoming_dividends.each do |dividend| %>
          <%= render "dividend_row", dividend: dividend, date_label: "Expected Payment" %>
        <% end %>
      </div>

      <% unless @premium_required %>
        <%= render "load_more",
          tab: "upcoming",
          current_limit: @upcoming_limit,
          total_count: @upcoming_total_count,
          historical_limit: @historical_limit,
          upcoming_limit: [@upcoming_limit + DividendsController::DEFAULT_PAGE_SIZE, DividendsController::MAX_PAGE_SIZE].min %>
      <% end %>
    <% else %>
      <%= render "dividend_empty_state", message: "No upcoming dividend announcements are available yet." %>
    <% end %>
  <% else %>
    <div class="mb-4">
      <h2 class="text-xl font-bold text-gray-900">Historical Dividends</h2>
      <p class="mt-1 text-sm text-gray-500">Past payouts imported from EODHD or entered manually by admins.</p>
    </div>

    <% if @historical_dividends.any? %>
      <div class="space-y-4">
        <% @historical_dividends.each do |dividend| %>
          <%= render "dividend_row", dividend: dividend, date_label: "Paid / Qualified" %>
        <% end %>
      </div>

      <% unless @premium_required %>
        <%= render "load_more",
          tab: "historical",
          current_limit: @historical_limit,
          total_count: @historical_total_count,
          historical_limit: [@historical_limit + DividendsController::DEFAULT_PAGE_SIZE, DividendsController::MAX_PAGE_SIZE].min,
          upcoming_limit: @upcoming_limit %>
      <% end %>
    <% else %>
      <%= render "dividend_empty_state", message: "No historical dividends are available yet. Sync EODHD dividends or add records from the admin dashboard." %>
    <% end %>
  <% end %>
</div>
