<div class="space-y-8">
  <div>
    <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Learn to Invest</h1>
    <p class="mt-1 text-gray-600">Short investing guides for reading Nigerian stocks with more confidence.</p>
  </div>

  <% if @featured_content %>
    <%= link_to educational_content_path(@featured_content), class: "block rounded-lg border border-emerald-200 bg-emerald-50 p-6 transition hover:border-emerald-300" do %>
      <span class="text-sm font-semibold text-emerald-700">Featured Lesson</span>
      <h2 class="mt-2 text-2xl font-bold text-gray-900"><%= @featured_content.title %></h2>
      <p class="mt-3 max-w-3xl text-gray-700"><%= @featured_content.summary %></p>
    <% end %>
  <% end %>

  <% if @categories.any? %>
    <div class="flex flex-wrap gap-2">
      <% @categories.each do |category| %>
        <span class="rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700"><%= category %></span>
      <% end %>
    </div>
  <% end %>

  <% if @contents.any? %>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% @contents.each do |content| %>
        <%= link_to educational_content_path(content), class: "block rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:border-emerald-300 hover:shadow-md" do %>
          <div class="flex items-center justify-between gap-4">
            <span class="text-sm font-semibold text-emerald-700"><%= content.category || "Investing" %></span>
            <span class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700"><%= content.difficulty_level.humanize %></span>
          </div>
          <h2 class="mt-3 text-lg font-semibold text-gray-900"><%= content.title %></h2>
          <p class="mt-2 line-clamp-3 text-sm leading-6 text-gray-600"><%= content.summary %></p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white p-12 text-center text-gray-500">
      Educational modules will appear here once published.
    </div>
  <% end %>
</div>
