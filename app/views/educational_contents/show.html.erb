<article class="mx-auto max-w-3xl space-y-8">
  <div>
    <%= link_to "Learn", educational_contents_path, class: "text-sm font-medium text-navy-700 hover:text-navy-800" %>
    <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-gray-500">
      <span class="rounded-full bg-navy-50 px-3 py-1 font-medium text-navy-700"><%= @content.category || "Investing" %></span>
      <span class="rounded-full bg-gray-100 px-3 py-1 font-medium text-gray-700"><%= @content.difficulty_level.humanize %></span>
    </div>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900"><%= @content.title %></h1>
    <p class="mt-5 text-lg leading-8 text-gray-700"><%= @content.summary %></p>
  </div>

  <% if @content.excerpt.present? %>
    <div class="rounded-lg border-l-4 border-navy-500 bg-navy-50 p-4">
      <p class="italic text-white"><%= @content.excerpt %></p>
    </div>
  <% end %>

  <% if @content.body.present? %>
    <div class="pgold pgold-sm max-w-none space-y-4 text-gray-700">
      <%= simple_format(@content.body) %>
    </div>
  <% end %>

  <% if @related_contents.any? %>
    <section class="border-t border-gray-200 pt-6">
      <h2 class="font-semibold text-gray-900">Related lessons</h2>
      <div class="mt-4 space-y-3">
        <% @related_contents.each do |content| %>
          <%= link_to content.title, educational_content_path(content), class: "block rounded-lg border border-gray-200 bg-white p-4 font-medium text-gray-900 hover:border-navy-300" %>
        <% end %>
      </div>
    </section>
  <% end %>
</article>
